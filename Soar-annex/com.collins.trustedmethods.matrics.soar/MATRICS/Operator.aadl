package Operator
public
	
	with Base_Types;
	
	system hardware
	end hardware;
	
	system software
	end software;
	
	system implementation hardware.impl
		annex soar {**
			sp {propose*latency-check
				(state <s> ^name cybersickness-monitor
						^latency-problem-threshold  <lut>
						^io.input-link.systemdata <sd>)
				(<sd> ^sys-latency <sl> > <lut>)

			-->
				(write (crlf) |Checking for cybersickness for System Latency value: | <sl>)
				(<s> ^operator <o> + >,=)
				(<o> ^name apply-latency-violated)

			}

			sp {propose*framerate-check
				(state <s> ^name cybersickness-monitor
						^framerate-problem-threshold  <fpt>
						^io.input-link.systemdata <sd>)
				(<sd> ^sys-framerate <sf> < <fpt>)

			-->
				(write (crlf) |Checking for cybersickness for System FrameRate value: | <sf>)
				(<s> ^operator <o> + =)
				(<o> ^name apply-framerate-violated)

			}

			sp {propose*opticflow-check
				(state <s> ^name cybersickness-monitor
						^optic-flow-threshold <ot>
						^io.input-link.systemdata <sd>)
				(<sd> ^sys-opticflow <sof> < <ot>)

			-->
				(write (crlf) |Checking for cybersickness for System OpticFlow Framerate: | <sof>)
				(<s> ^operator <o> + < )
				(<o> ^name apply-opticflow-violated)

			}
			sp {apply*apply-latency-violated
				(state <s> ^operator.name apply-latency-violated
						^io.output-link <out>)
				(<out> ^cybersickness-level <cl>)

			-->
				(write (crlf) |Latency Incapacitated...|)
				(<out> ^cybersickness-level <cl> - incapacitated-level-III +)
			
			}
			sp {apply*apply-framerate-check
				(state <s> ^operator.name apply-framerate-violated
						^io.output-link <out>)
				(<out> ^cybersickness-level <cl>)

			-->
				(write (crlf) |Incapacitated...|)
				(<out> ^cybersickness-level <cl> - affected-level-II +)

			}
			sp {apply*apply-opticflow-violated
				(state <s> ^operator.name apply-opticflow-violated
						^io.output-link <out>)
				(<out> ^cybersickness-level <cl>)

			-->
				(write (crlf) |Affected...|)
				(<out> ^cybersickness-level <cl> - affected-level-I +)
			}
		
	**};
	end hardware.impl;
	
	system implementation software.impl
--		annex soar {**
--
--	**};
	end software.impl;
	
	system Operator
		features
			frame_rate: in event data port Base_Types::Integer;
			not_cybersick: out event data port Base_Types::Boolean;
		annex agree {**
			assume Frame_Rate_Range "Frame rate is positive and less than 60" : event(frame_rate) => frame_rate > 0;
			guarantee No_Cybersickness "Operator will not get cybersick" : (event(not_cybersick) and not_cybersick = true) -> if (event(frame_rate) and (pre(frame_rate) > 40 or frame_rate > 40)) then (event(not_cybersick) and not_cybersick = false) else (event(not_cybersick) and not_cybersick = true);
		**};
	end Operator;
	
	system implementation Operator.impl
		subcomponents
			hardware: system hardware.impl;
			software: system software.impl;
		annex soar {**
			sp {propose*initialize
				(state <s> ^superstate nil
						^io.input-link.systemdata <sd>
						-^name)
			
			-->
				(<s> ^operator <o> + >,=)
				(<o> ^name initialize)
				(write (crlf) |Agent initializing...|)

			}
			 
			 sp {apply*initialize
				(state <s> ^operator.name initialize
						^io.output-link <out>)
			-->
				(<s> ^name cybersickness-monitor)
				(<s> ^latency-problem-threshold 40)
				(<s> ^framerate-problem-threshold 40)
				(<s> ^optic-flow-threshold 1)
				(<out> ^cybersickness-check none)
				(<out> ^cybersickness-level none)
				(write (crlf) |Agent initialized.|)
			}
		**};
		annex agree {**
			assign not_cybersick = if frame_rate > 40 then true else false;
		**};
	end Operator.impl;

end Operator;