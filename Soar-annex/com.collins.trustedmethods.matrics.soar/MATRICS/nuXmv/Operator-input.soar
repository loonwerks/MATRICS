sp {propose*initialize
    (state <s> ^superstate nil)
    (<s> -^name )
    (<s> ^io <i*1>)
    (<i*1> ^input-link <i*2>)
    (<i*2> ^systemdata <sd>)
    -->
    (<s> ^operator <o> +)
    (<s> ^operator <o> >)
    (<s> ^operator <o> =)
    (<o> ^name initialize +)
    (write (crlf) |Agent initializing_..|)
}
sp {apply*initialize
    (state <s> ^operator <o*1>)
    (<o*1> ^name initialize)
    (<s> ^io <i*1>)
    (<i*1> ^output-link <out>)
    -->
    (<s> ^name cybersickness-monitor +)
    (<s> ^latency-mid-threshold 20 +)
    (<s> ^latency-upper-threshold 40 +)
    (<s> ^framerate-mid-threshold 60 +)
    (<s> ^framerate-problem-threshold 40 +)
    (<s> ^optic-flow-threshold 1 +)
    (<out> ^cybersickness-check none +)
    (<out> ^cybersickness-level none +)
    (write (crlf) |Agent initialized_|)
}
sp {propose*latency-check
    (state <s> ^name cybersickness-monitor)
    (<s> ^latency-upper-threshold <lut>)
    (<s> ^io <i*1>)
    (<i*1> ^input-link <i*2>)
    (<i*2> ^systemdata <sd>)
    (<sd> ^sys-latency { > <lut>  })
    (<sd> ^sys-latency <sl>)
    -->
    (write (crlf) |Checking for cybersickness for System Latency value: | <sl>)
    (<s> ^operator <o> +)
    (<s> ^operator <o> >)
    (<s> ^operator <o> =)
    (<o> ^name apply-latency-violated +)
}
sp {propose*framerate-check
    (state <s> ^name cybersickness-monitor)
    (<s> ^framerate-problem-threshold <fpt>)
    (<s> ^io <i*1>)
    (<i*1> ^input-link <i*2>)
    (<i*2> ^systemdata <sd>)
    (<sd> ^sys-framerate { < <fpt>  })
    (<sd> ^sys-framerate <sf>)
    -->
    (write (crlf) |Checking for cybersickness for System FrameRate value: | <sf>)
    (<s> ^operator <o> +)
    (<s> ^operator <o> =)
    (<o> ^name apply-framerate-violated +)
}
sp {propose*opticflow-mid-check
    (state <s> ^name cybersickness-monitor)
    (<s> ^optic-flow-threshold <ot>)
    (<s> ^io <i*1>)
    (<i*1> ^input-link <i*2>)
    (<i*2> ^systemdata <sd>)
    (<sd> ^sys-opticflow { < <ot>  })
    (<sd> ^sys-opticflow <sof>)
    -->
    (write (crlf) |Checking for cybersickness for System Mid OpticFlow Framerate: | <sof>)
    (<s> ^operator <o> +)
    (<s> ^operator <o> <)
    (<o> ^name apply-opticflow-mid-violated +)
}
sp {apply*apply-framerate-check
    (state <s> ^operator <o*1>)
    (<o*1> ^name apply-framerate-violated)
    (<s> ^io <i*1>)
    (<i*1> ^output-link <out>)
    (<out> ^cybersickness-level <cl>)
    -->
    (write (crlf) |Incapacitated_..|)
    (<out> ^cybersickness-level <cl> -)
    (<out> ^cybersickness-level affected-level-II +)
}
sp {apply*apply-latency-violated
    (state <s> ^operator <o*1>)
    (<o*1> ^name apply-latency-violated)
    (<s> ^io <i*1>)
    (<i*1> ^output-link <out>)
    (<out> ^cybersickness-level <cl>)
    -->
    (write (crlf) |Latency Incapacitated_..|)
    (<out> ^cybersickness-level <cl> -)
    (<out> ^cybersickness-level incapacitated-level-III +)
}
sp {apply*apply-opticflow-mid-violated
    (state <s> ^operator <o*1>)
    (<o*1> ^name apply-opticflow-mid-violated)
    (<s> ^io <i*1>)
    (<i*1> ^output-link <out>)
    (<out> ^cybersickness-level <cl>)
    -->
    (write (crlf) |Affected_..|)
    (<out> ^cybersickness-level <cl> -)
    (<out> ^cybersickness-level affected-level-I +)
}

