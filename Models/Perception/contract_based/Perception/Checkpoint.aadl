package Checkpoint
public
	with Operator;
	with HMD;
	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 10.0; 
		const HIGH_LIGHT : real = 80.0;  
		const MAX_LIGHT : real = 100.0;
		const ZERO_LIGHT : real = 0.0; 
	**}; 
	system Checkpoint
		features
			ambient_light : in data port  Base_Types::Float; 
			target_within_fov : in data port  Base_Types::Boolean;			
			light_around_target:  in data port Base_Types::Float; -- attack effects light around target..  
			mission_success: out data port Base_Types::Boolean;
		annex agree {**
			node counter(cond: bool) returns (output : int); var count : int; 
			let output  = count; count = if cond then 0->pre(count) + 1 else 0->pre(count); tel;  
			node persistent(cond : bool, t: int) returns (output : bool); var count : int; 
			let output = if count>=t then true else false; count = if cond then 0->pre(count) + 1 else 0; tel; 
			assume ambient_light_is_low "A: Ambient light is low" : ambient_light>=LOW_LIGHT and ambient_light<=30.0; -- low ambient light 
			assume light_around_target_invariant "A: light around target >= ambient light" : light_around_target>=ambient_light ; 
			guarantee always_detection "G: checkpoint guard will eventually detect the target with contraband" : 
						persistent(target_within_fov,30) => counter(mission_success)>0; 
		**};
	end Checkpoint;

	system implementation Checkpoint.impl
		subcomponents
			HMD: system HMD::HMD.mon;
			Operator: system Operator::Operator.impl;
		connections
			c2: port Operator.detect_target -> mission_success;
			c1: port HMD.target_is_marked -> Operator.target_is_marked ; 
			c3: port ambient_light -> Operator.ambient_light; 
			c4: port target_within_fov -> HMD.target_within_fov; 
			c5: port HMD.filtered_light_around_target -> Operator.filtered_light_around_target; 
			c6: port light_around_target -> HMD.light_around_target ; 
	--	properties 
		--	period => 30 ms; 
		annex agree {**
			assert ambient_light_is_between_0_and_high "Domain of ambient light" : ambient_light>=ZERO_LIGHT and ambient_light<=MAX_LIGHT ; 
			assert light_around_target_is_between_0_and_high "Domain of light around target" : light_around_target>=ZERO_LIGHT and light_around_target<=MAX_LIGHT ; 
			
		**}; 
			
	end Checkpoint.impl;

end Checkpoint;