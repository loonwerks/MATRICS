package Operator
public

	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 10.0; 
		const HIGH_LIGHT : real = 80.0;  
	**}; 
	system hardware
	end hardware;

	system software
	end software;

	system implementation hardware.impl
	end hardware.impl;

	system implementation software.impl

	end software.impl;

	-- annex could be outside of component: then its content becomes global
	system Operator
		features
			ambient_light: in data port Base_Types::Float;
			target_is_marked: in data port Base_Types::Boolean;
			filtered_light_around_target: in data port Base_Types::Float;
			detect_target: out data port Base_Types::Boolean;
	--	properties
	--		period => 30ms;
		annex agree {**
			-- no memories in functions
			fun within_delta(q1: real, q2: real, d: real) : bool = if (q1>=q2) then (q1 - q2)<d else (q2 - q1)> ( -1.0 * d ) ; 
			fun ge_than_delta(q1: real, q2: real, d: real) : bool = (q1 - q2)>=d ; 		
			-- yes memories in nodes	
			node persistent(cond : bool, t: int) returns (output : bool); var count : int; 
			let output = if count>=t then true else false; count = if cond then 0->pre(count) + 1 else 0; tel; 
			assume amblient_light_range "A: Ambient light between this range" : ambient_light <= HIGH_LIGHT and ambient_light >= LOW_LIGHT;
			guarantee target_detection_under_similar_light_1 "G: Lower light around target for at least 10 ticks before detection" : 
			not persistent(target_is_marked and within_delta(filtered_light_around_target,ambient_light,35.0),6)=> not detect_target;
			guarantee target_detection_under_similar_light_2 "G: Lower light around target for at least 10 ticks before detection" : 
				persistent(target_is_marked and within_delta(filtered_light_around_target,ambient_light,35.0),6)=> detect_target;
		**};
	end Operator;

	system implementation Operator.impl

	end Operator.impl;
	
end Operator;