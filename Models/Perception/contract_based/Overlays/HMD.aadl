package HMD
public
	with Base_Types;
	
	system Light_Filter
		features
			perceived_light_around_target: in data port Base_Types::Float;
			filtered_light_around_target: out data port Base_Types::Float;
		annex agree {**
			guarantee bad_filter "G: poor filter i.e. filtered light out is similar to light in" : filtered_light_around_target = perceived_light_around_target; 
				
		**};
	end Light_Filter;
	
	system implementation Light_Filter.impl

	end Light_Filter.impl;
	
	system Display
		features
			light_around_target : in data port Base_Types::Float; 
			target_within_fov : in data port Base_Types::Boolean; 
			red_overlay_attack:  in data port Base_Types::Float; -- hacker effects green_overlay.. t
			green_overlay_attack: in data port Base_Types::Float; -- heacker effects red overlay.. transparency value, 
			target_is_marked : out data port Base_Types::Boolean; 
			target_is_covered_by_green_box: out data port Base_Types::Float; 
			target_is_covered_by_red_box: out data port Base_Types::Float; 
			
			
		annex agree {**
			-- when
						node persistent(cond : bool, t: int) returns (output : bool); var count : int; 
			let output = if count>=t then true else false; count = if cond then 0->pre(count) + 1 else 0; tel; 
			
			guarantee display_target_1 "G: display will marked a target within FOV with a green bounding box." : persistent(target_within_fov, 5) => target_is_marked; 
			guarantee display_target_2 "G: otherwise no bounding box" : not persistent(target_within_fov, 5) => not target_is_marked; 
			guarantee overlay_green_box "G: transparent green box over the green bounding box" : target_is_marked => target_is_covered_by_green_box = green_overlay_attack; 
			guarantee overlay_red_box  "G: transparent red box over the green bounding box" : target_is_marked => target_is_covered_by_red_box = red_overlay_attack; 
			guarantee no_overlay_if_target_is_not_marked "G: if no target are marked then overlay" : not target_is_marked => target_is_covered_by_green_box = 0.0 and target_is_covered_by_red_box = 0.0; 
		**};
	end Display;
	
	system implementation Display.impl
		annex agree {**
		**};
	end Display.impl;
	
	system HMD
		features
			target_within_fov:  in data port Base_Types::Boolean;
			red_overlay_attack:  in data port Base_Types::Float; -- hacker effects green_overlay.. t
			green_overlay_attack: in data port Base_Types::Float; -- hacker effects red overlay.. transparency value, 
			target_is_marked : out data port Base_Types::Boolean; 
			target_is_covered_by_green_box: out data port Base_Types::Float; 
			target_is_covered_by_red_box: out data port Base_Types::Float; 
			
	end HMD;
	
	system implementation HMD.init
		subcomponents
			Display: system Display.impl;
		connections
			c2: port Display.target_is_marked -> target_is_marked;
		annex agree {**
		**};
	end HMD.init;
	
	system implementation HMD.mon
		subcomponents
			Display: system Display.impl;
			Filter: system Light_Filter.impl;
		connections
			c1: port Display.target_is_marked -> target_is_marked;
			c2: port green_overlay_attack->Display.green_overlay_attack;
			c3: port target_within_fov -> Display.target_within_fov ; 
			c4: port red_overlay_attack -> Display.red_overlay_attack; 
			c5: port Display.target_is_covered_by_green_box -> target_is_covered_by_green_box; 
			c6: port Display.target_is_covered_by_red_box -> target_is_covered_by_red_box; 
	--	properties 
	--		period => 20 ms; 
		annex agree {**
				
		**};
	end HMD.mon;
	
end HMD;