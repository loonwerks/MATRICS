package Operator
public

	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 10.0; 
	**}; 
	system hardware
	end hardware;

	system software
	end software;

	system implementation hardware.impl
	end hardware.impl;

	system implementation software.impl

	end software.impl;

	-- annex could be outside of component: then its content becomes global
	system Operator
		features
			ambient_light: in data port Base_Types::Float;
			target_is_marked: in data port Base_Types::Boolean;
			filtered_light_around_target: in data port Base_Types::Float;
			detect_target: out data port Base_Types::Boolean;

		annex agree {**
			-- no memories in functions
			fun exceed(q1: real, q2: real, d: real) : 
			    bool = (q1 - q2)>=d ; 		
			node occured(cond : bool, t: int) returns (output : bool);  
			    var count : int; 
			    let output  = if cond then true else 
			    if count<=t then false->pre(output) else false; 
			    count = if not cond then 0->pre(count) + 1 else 0; tel;  	 
			node persistent(cond : bool, t: int) returns (output : bool); 
			    var count : int; 
			    let output = if count>=t then true else false; count = 
			    if cond then 0->pre(count) + 1 else 0; tel;
			node duration(cond : bool, t1: int, t2: int) returns (output : bool); 
			    var count : int; 
			    let output = if (count<=t2 and count>=t1) then true else false; 
			    count = if cond then 0->pre(count) + 1 else 0; tel;
			guarantee target_detection 
			    "G: no attack means detection.": 	
			    persistent(target_is_marked,15) and 
			    not occured(duration(
			    exceed(filtered_light_around_target,ambient_light,90.0),10,36),124)
			        => detect_target; 
			guarantee no_target_detection 
			    "G: an attack means no detection for a period.": 
			    not persistent(target_is_marked,15) 
			    or occured(duration(
			    exceed(filtered_light_around_target,ambient_light,90.0), 10, 36),124) 
			        => not detect_target; 
			 -- 124 ticks (20ms per tick) is the 2 sigma time delay due to contraction and dilation data.. 
		**};
	end Operator;

	system implementation Operator.impl
--	properties
	--		period => 20ms;

	end Operator.impl;
	
end Operator;