package Operator
public

	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 20.0; 
	**}; 
	system hardware
	end hardware;

	system software
	end software;

	system implementation hardware.impl
	end hardware.impl;

	system implementation software.impl

	end software.impl;

	-- annex could be outside of component: then its content becomes global
	system Operator
		features
			target_is_marked: in data port Base_Types::Boolean;
			detect_target: out data port Base_Types::Boolean;
			bounding_box_inv_contrast: in data port Base_Types::Float;
		properties 
			Period => 20ms; 
		annex agree {**
			-- no memories in functions
			fun exceed(q1: real, q2: real, d: real) : 
			    bool = (q1 - q2)>=d ; 		
			node occured(cond : bool, t: int) returns (output : bool);  
			    var count : int; 
			    let output  = if cond then true else 
			    if count<=t then false->pre(output) else false; 
			    count = if not cond then 0->pre(count) + 1 else 0; tel;  	 
			node persistent(cond : bool, t: int) returns (output : bool); 
			    var count : int; 
			    let output = if count>=t then true else false; count = 
			    if cond then 0->pre(count) + 1 else 0; tel;
			node duration(cond : bool, t1: int, t2: int) returns (output : bool); 
			    var count : int; 
			    let output = if (count<=t2 and count>=t1) then true else false; 
			    count = if cond then 0->pre(count) + 1 else 0; tel;
			assume range_of_inv_contrast "Domain of inverse contrast model" : bounding_box_inv_contrast>=0.1 and bounding_box_inv_contrast<=200.0 ; 			
			
			-- piecewise constant discretization of the linear model (SP at 2 cd/m2 for high spatial freq 7.48 from Plainis 
			guarantee target_detection_0
			    "G: .. inverse contrast <= 1 means reaction time of <= 14.": 		
			    (persistent(bounding_box_inv_contrast>0.1 and bounding_box_inv_contrast<=1.0, 14) and persistent(target_is_marked,14)) => detect_target; 	
			guarantee target_detection_1 
			    "G: .. inverse contrast <= 5 means reaction time of <= 15.": 	
			    (persistent(bounding_box_inv_contrast>1.0 and bounding_box_inv_contrast<=5.0, 15) and persistent(target_is_marked,15)) => detect_target; 
			guarantee target_detection_2 
			    "G: .. inverse contrast <= 10 means reaction time of <= 17.": 	
			    (persistent(bounding_box_inv_contrast>5.0 and bounding_box_inv_contrast<=10.0,17) and persistent(target_is_marked,17)) => detect_target; 
			guarantee target_detection_3 
			    "G:.. inverse contrast <= 20 means reaction time of <= 19.": 	
			    (persistent(bounding_box_inv_contrast>10.0 and bounding_box_inv_contrast<=20.0,19) and persistent(target_is_marked,19)) => detect_target; 
			guarantee target_detection_4 
			    "G:.. inverse contrast <= 30 means reaction time of <= 21.": 	
			    (persistent(bounding_box_inv_contrast>20.0 and bounding_box_inv_contrast<=30.0,21) and persistent(target_is_marked,21))=> detect_target; 
			guarantee target_detection_5 
			    "G:.. inverse contrast <= 40 means reaction time of <= 24.": 	
			    (persistent(bounding_box_inv_contrast>30.0 and bounding_box_inv_contrast<=40.0,24) and persistent(target_is_marked,24))=> detect_target; 
			guarantee target_detection_6 
			    "G:.. inverse contrast <= 50 means reaction time of <= 26.": 	
			   (persistent(bounding_box_inv_contrast>40.0 and bounding_box_inv_contrast<=50.0,26) and persistent(target_is_marked,26))=> detect_target; 			    
			guarantee target_detection_7 
			    "G:.. inverse contrast <= 200 means reaction time of <= 61.": 	
			   (persistent(bounding_box_inv_contrast>50.0 and bounding_box_inv_contrast<=200.0,61) and persistent(target_is_marked,61))=> detect_target; 
		**};
	end Operator;

	system implementation Operator.impl
--	properties
	--		period => 20ms;

	end Operator.impl;
	
end Operator;