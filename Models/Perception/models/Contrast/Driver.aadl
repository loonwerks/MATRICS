package Driver
public
	with Operator;
	with HMD;
	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 20.0; 
		const HIGH_LIGHT : real = 100.0;  
		const MAX_LIGHT : real = 400.0;
		const ZERO_LIGHT : real = 0.02; 
	**}; 
	system Driver
		features
			ambient_light : in data port  Base_Types::Float; 
			target_within_fov : in data port  Base_Types::Boolean;			
					hacker_input : in data port Base_Types::Float; -- modeling a hacker.. 
		
			mission_success: out data port Base_Types::Boolean;

		annex agree {**
			fun ge_than_delta(q1: real, q2: real, d: real) : bool = (q1 - q2)>=d ; 	
			node counter(cond: bool) returns (output : int); var count : int; 
			let output  = count; count = if cond then 0->pre(count) + 1 else 0->pre(count); tel;  
			node persistent(cond : bool, t: int) returns (output : bool); var count : int; 
			let output = if count>=t then true else false; count = if cond then 0->pre(count) + 1 else 0; tel; 
			node persistentleq(cond : bool, t: int) returns (output : bool); var count : int; 
			let output = if (count<=t and count>0) then true else false; count = if cond then 0->pre(count) + 1 else 0; tel;
			assume ambient_light_is_low "A: ambient light is around 20" : ambient_light>=19.8 and ambient_light<=20.2; -- low light condition 
			--assume successful_attack "A: manipulates the contrast enough to endanger the mission" : hacker_input=-99.0; 
			assume unsuccessful_attack "A: manipulates the contrast but not by enough to endanger the mission." : hacker_input=-80.0; 
			guarantee always_detection "G: if an object is within FOV and visual range for 0.5 seconds, the driver will detect it within 0.5 seconds." : 
						persistent(target_within_fov,25) => counter(mission_success)>0; 
		**};
	end Driver;

	system implementation Driver.impl
		subcomponents
			HMD: system HMD::HMD.mon;
			Operator: system Operator::Operator.impl;
		connections
			c1: port HMD.target_is_marked -> Operator.target_is_marked ; 
			c2: port Operator.detect_target -> mission_success;
			c3: port ambient_light -> HMD.ambient_light; 
			c4: port target_within_fov -> HMD.target_within_fov; 
			c5: port HMD.bounding_box_inv_contrast -> Operator.bounding_box_inv_contrast; 
			c6: port hacker_input -> HMD.hacker_input; 
		properties 
			Period => 20ms; 
		annex agree {**
			assert ambient_light_is_between_0_and_high "Domain of ambient light" : ambient_light>=ZERO_LIGHT and ambient_light<=MAX_LIGHT ; 			
			assert hacker_limits "limited to between 0 and -99.8" : hacker_input>=-99.0 and hacker_input<=0.0; 
		**}; 
			
	end Driver.impl;

end Driver;