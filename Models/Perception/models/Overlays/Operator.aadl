package Operator
public

	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 10.0; 
	**}; 
	system hardware
	end hardware;

	system software
	end software;

	system implementation hardware.impl
	end hardware.impl;

	system implementation software.impl

	end software.impl;

	-- annex could be outside of component: then its content becomes global
	system Operator
		features
			ambient_light: in data port Base_Types::Float;
			target_is_marked: in data port Base_Types::Boolean;
			filtered_light_around_target: in data port Base_Types::Float;
			detect_target: out data port Base_Types::Boolean;
			green_box_over_bounding_box: in data port Base_Types::Float;
			red_box_over_bounding_box: in data port Base_Types::Float;

		annex agree {**
			-- no memories in functions
			fun exceed(q1: real, q2: real, d: real) : 
			    bool = (q1 - q2)>=d ; 		
			node occured(cond : bool, t: int) returns (output : bool);  
			    var count : int; 
			    let output  = if cond then true else 
			    if count<=t then false->pre(output) else false; 
			    count = if not cond then 0->pre(count) + 1 else 0; tel;  	 
			node persistent(cond : bool, t: int) returns (output : bool); 
			    var count : int; 
			    let output = if count>=t then true else false; count = 
			    if cond then 0->pre(count) + 1 else 0; tel;
			node duration(cond : bool, t1: int, t2: int) returns (output : bool); 
			    var count : int; 
			    let output = if (count<=t2 and count>=t1) then true else false; 
			    count = if cond then 0->pre(count) + 1 else 0; tel;
			
			guarantee normal_target_detection 
			    "G: no box overlay means normal detection": 	
			    persistent(target_is_marked and red_box_over_bounding_box=0.0 and green_box_over_bounding_box=0.0,31)
			        => detect_target; 
			
			guarantee red_overlay_delay_target_detection 
			    "G: red overlay over green bounding box means delayed reaction...": 	
			    persistent(target_is_marked and red_box_over_bounding_box=70.0 and green_box_over_bounding_box=0.0,99)
			        => detect_target; -- 99 ticks is the +2 sigma value taken from the Kaiming paper.
			
			guarantee green_overlay_delay_target_detection 
			    "G: green overlay over green bounding box means delayed reaction...": 	
			    persistent(target_is_marked and red_box_over_bounding_box=0.0 and green_box_over_bounding_box=70.0,107)
			        => detect_target; -- 107 ticks is the +2 sigma value taken from the Kaiming paper.
		**};
	end Operator;

	system implementation Operator.impl
--	properties
	--		period => 20ms;

	end Operator.impl;
	
end Operator;