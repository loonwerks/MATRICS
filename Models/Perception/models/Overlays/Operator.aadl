package Operator
public

	with Base_Types;
	annex agree{**
		-- these contants are global.
		const LOW_LIGHT : real = 10.0; 
	**}; 
	system hardware
	end hardware;

	system software
	end software;

	system implementation hardware.impl
	end hardware.impl;

	system implementation software.impl

	end software.impl;

	-- annex could be outside of component: then its content becomes global
	system Operator
		features
			target_marked: in data port Base_Types::Boolean; -- bounding box of color 1 (red) appears around target 
			target_identified :  in data port Base_Types::Boolean; -- bounding box switches from color 1 to color 2 (target)
			detect_target: out data port Base_Types::Boolean;
			green_overlay: in data port Base_Types::Float;
			red_overlay: in data port Base_Types::Float;
		annex agree {**
			fun exceed ( q1 : real , q2 : real , d : real ) : bool = ( q1 - q2 ) >= d ;
			node persistent ( cond : bool , t : int ) returns ( output : bool ) ; var count : int ; let output = if count >= t then true else false ; count = if cond then 0 -> pre ( count ) + 1 else 0 ; tel ;
			node duration ( cond : bool , t1 : int , t2 : int ) returns ( output : bool ) ; var count : int ; let output = if count <= t2 and count >= t1 then true else false ; count = if cond then 0 -> pre ( count ) + 1 else 0 ; tel ;
			guarantee normal_target_detection "G: no box overlay means normal detection..." : 
				persistent ( target_identified and green_overlay = 0.0 and red_overlay = 0.0 , 31 ) => detect_target;
			guarantee red_overlay_delay_target_detection "G: red overlay over green bounding box means delayed reaction..." : 
				persistent ( target_identified and red_overlay = 70.0 and green_overlay = 0.0 , 99 ) => detect_target;
			guarantee green_overlay_delay_target_detection "G: green overlay over green bounding box means delayed reaction..." : 
			persistent ( target_identified and red_overlay = 0.0 and green_overlay = 70.0 , 107 ) => detect_target;
		**};
	end Operator;

	system implementation Operator.impl
--	properties
	--		period => 20ms;

	end Operator.impl;
	
end Operator;