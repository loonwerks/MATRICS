package HMD
public
	with Base_Types;
	
	
	system Display
		features
			target_within_fov : in data port Base_Types::Boolean; -- a person is within the FOV or not. 
			red_overlay_attack:  in data port Base_Types::Boolean; -- hacker effects green_overlay.. t
			green_overlay_attack: in data port Base_Types::Boolean; -- heacker effects red overlay.. transparency value, 
			target_marked : out data port Base_Types::Boolean; 
			target_identified : out data port Base_Types::Boolean; 
			
			green_box_overlay: out data port Base_Types::Float; 
			red_box_overlay: out data port Base_Types::Float; 
			
		annex agree {**
			-- when
			node persistent(cond : bool, t: int) returns (output : bool); var count : int; 
			let output = if count>=t then true else false; count = if cond then 0->pre(count) + 1 else 0; tel; 
			
			guarantee identify_human "G: display (ATR1) will marked a human within FOV with a bounding box of color 1 after 100ms." : 
				persistent(target_within_fov, 5) => target_marked; -- 100ms
			guarantee not_identify_human "G: otherwise not marked as a human." : not persistent(target_within_fov, 2) => not target_marked; 
			
			guarantee identify_target "G: display (ATR2) will identify a marked human as a target with a bounding box of color 2 after 500ms." : 
				persistent(target_marked, 25) => target_identified; -- 500ms
			guarantee not_identify_target "G: otherwise not identified as target." : not persistent(target_marked, 25) => not target_identified; 			
			guarantee overlay_green_box "G: transparent color 2 box over the color 2 bounding box" : target_identified and green_overlay_attack => green_box_overlay = 70.0; 
			guarantee overlay_red_box  "G: transparent color 1 box over the color 2 bounding box" : target_identified and red_overlay_attack => red_box_overlay = 70.0 ; 
			guarantee no_overlay_if_target_not_marked "G: if no target are marked then overlay" : 
				not target_identified or 
				(target_identified and not (green_overlay_attack or red_overlay_attack))
				=> green_box_overlay = 0.0 and red_box_overlay = 0.0; 
		**};
	end Display;
	
	system implementation Display.impl
		annex agree {**
		**};
	end Display.impl;
	
	system HMD
		features
			target_within_fov:  in data port Base_Types::Boolean;
			red_overlay_attack:  in data port Base_Types::Boolean; -- hacker effects green_overlay.. t
			green_overlay_attack: in data port Base_Types::Boolean; -- hacker effects red overlay.. transparency value, 
			target_marked : out data port Base_Types::Boolean; 
			target_identified :  out data port Base_Types::Boolean; -- bounding box switches from color 1 to color 2 (target)
			target_covered_by_green_box: out data port Base_Types::Float; 
			target_covered_by_red_box: out data port Base_Types::Float; 
	end HMD;
	
	system implementation HMD.init
		subcomponents
			Display: system Display.impl;
		connections
			c2: port Display.target_marked -> target_marked;
		annex agree {**
		**};
	end HMD.init;
	
	system implementation HMD.mon
		subcomponents
			Display: system Display.impl;
		connections
			c1: port Display.target_marked -> target_marked;
			c2: port green_overlay_attack->Display.green_overlay_attack;
			c3: port target_within_fov -> Display.target_within_fov ; 
			c4: port red_overlay_attack -> Display.red_overlay_attack; 
			c5: port Display.green_box_overlay -> target_covered_by_green_box; 
			c6: port Display.red_box_overlay -> target_covered_by_red_box; 
			c7: port Display.target_identified -> target_identified;
			
	--	properties 
	--		period => 20 ms; 
		annex agree {**
				
		**};
	end HMD.mon;
	
end HMD;