	-- High-Assurance Components
	-- monitors the behavior of the dataManager component	
	thread logMonitor
		features
			request_log: in event data port Common::Request.Impl;
			response_log_in: in event data port Common::ResponseLog.Impl;
			response_log_out: out event data port Common::ResponseLog.Impl;			
			alert: out event port;
		flows
			f1: flow path request_log -> response_log_out;
			f2: flow path response_log_in -> response_log_out;
			f3: flow source alert;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
		annex agree {**
			eq is_valid: bool = 
				if event(request_log) and event(response_log_in)
				then true
				else event(response_log_in) => Yesterday(
					Since(
						not(
							event(response_log_in)
						), event(request_log)
					)
				);

			guarantee Alert "G: Send an alert if more than one response is received without a request." :
				if event(response_log_in) and not(is_valid)
				then event(alert)
				else not(event(alert));
			guarantee Forward_Response "G: Only forward a response if a valid request has been made." :
				if event(response_log_in) and Historically(not(event(alert)))
				then event(response_log_out) and (response_log_out = response_log_in)
				else not(event(response_log_out));
		**};
		annex GUMBO{**
			state
				since_result: Base_Types::Boolean;
				is_valid: Base_Types::Boolean;
				historically_no_alert_cmd: Base_Types::Boolean;
			initialize
				modifies since_result, historically_no_alert_cmd;
				guarantee defaultSince:
					since_result == false;
				guarantee defaultIsValid:
					historically_no_alert_cmd == true;
				
			compute
				modifies since_result, is_valid, historically_no_alert_cmd;
				
				guarantee is_valid_variable "G: is_valid set correctly" :
					if (HasEvent(request_log) & HasEvent(response_log_in)) 
					is_valid == true 
					else (HasEvent(response_log_in) ->: In(since_result));
				
				
				guarantee since_result_variable "G: since_result is equivalent to (not response_log_in event) Since (request_log event)":
					since_result == GUMBO_PLTL::Since(!HasEvent(response_log_in), HasEvent(request_log), In(since_result));
				
					
                guarantee Alert "G: Send an alert if more than one response is received without a request." :
					if (HasEvent(response_log_in) & !(is_valid)) 
					(MustSend(alert) & historically_no_alert_cmd == false)
					else (NoSend(alert) & (In(historically_no_alert_cmd) == historically_no_alert_cmd));
				guarantee Forward_Response "G: Only forward a response if a valid request has been made." :
					if (HasEvent(response_log_in) & historically_no_alert_cmd)
					(MustSend(response_log_out) & (response_log_out == response_log_in))
					else NoSend(response_log_out);
		**};
	end logMonitor;
	
	process logMonitor_seL4
		features
			request_log: in event data port Common::Request.Impl;
			response_log_in: in event data port Common::ResponseLog.Impl;
			response_log_out: out event data port Common::ResponseLog.Impl;
			alert: out event port;
		flows
			f1: flow path request_log -> response_log_out;
			f2: flow path response_log_in -> response_log_out;
			f3: flow source alert;
		properties
			MATRICS_Properties::Component_Type => MONITOR;
	end logMonitor_seL4;
	
	process implementation logMonitor_seL4.Impl
		subcomponents
			logMonitor: thread logMonitor;
		connections
			c1: port request_log -> logMonitor.request_log;
			c2: port response_log_in -> logMonitor.response_log_in;
			c3: port logMonitor.response_log_out -> response_log_out;
			c4: port logMonitor.alert -> alert;
		properties
			CASE_Scheduling::Domain => 8;
		annex agree {**
			lift contract;
		**};
	end logMonitor_seL4.Impl;

	-- monitors the behavior of the dataAnalysis component and incoming requests
	thread reportMonitor
		features
			analysis_request: in event data port Common::AnalysisRequest.Impl;
			analysis_report_in: in event data port Common::AnalysisReport.Impl;
			analysis_report_out: out event data port Common::AnalysisReport.Impl;
			alert: out event port;
		flows
			f1: flow path analysis_request -> analysis_report_out;
			f2: flow path analysis_report_in -> analysis_report_out;
			f3: flow source alert;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;			
		annex agree {**
			node Counter(i: bool, reset: bool) returns (count: int);
			let
				count = if reset then 0 
							else 0 -> if i then pre(count) + 1 
								else pre(count);
			tel;
			
			const threshold: int = 3;			
			eq is_valid1: bool = 
				if event(analysis_request) and event(analysis_report_in)
				then true
				else event(analysis_report_in) => Yesterday(Since(not(event(analysis_report_in)), event(analysis_request)));
			eq is_invalid2: bool = Counter(event(analysis_request), event(analysis_report_in)) >= threshold;
								 
			guarantee Alert1 "G: Send an alert if more than one report is received without a request." :
				if event(analysis_report_in) and not(is_valid1)
				then event(alert)
				else not(event(alert));
			guarantee Alert2 "G: Send an alert if 3 or more requests are received without a report." :
				if is_invalid2
				then event(alert)
				else not(event(alert));
			guarantee Forward_Report "G: Only forward a report if a valid request has been made and it is to a trusted destination." :
				if event(analysis_report_in) and is_valid1 and not(is_invalid2) and FOUND_IN_ALLOW_LIST(ALLOW_LIST, analysis_report_in.header.client)
				then event(analysis_report_out) and (analysis_report_out = analysis_report_in)
				else not(event(analysis_report_out));	
		**};
		annex GUMBO {**
			state
				counter: Base_Types::Unsigned_32;
				since_result: Base_Types::Boolean;
				is_valid1: Base_Types::Boolean;
				is_invalid2: Base_Types::Boolean;
			functions
				def Counter(i: Base_Types::Boolean, reset: Base_Types::Boolean, count: Base_Types::Unsigned_32): Base_Types::Unsigned_32 :=
					if (reset == true) 
                         u32"0" 
                         else (
                              if (i == true) 
                              (count + u32"1") 
                              else count
                         );
				def ALLOW_LIST(): MATRICS_MODEL_Transformations::AllowList.Impl := MATRICS_MODEL_Transformations::AllowList.Impl(u32"1", u32"2", u32"3", u32"4");
				def FOUND_IN_ALLOW_LIST(allow_list: MATRICS_MODEL_Transformations::AllowList.Impl, src: Base_Types::Unsigned_32): Base_Types::Boolean :=
					(Exists(0 until allow_list.size)(i => allow_list(i) == src));				
			initialize
				modifies counter, since_result;
				
				guarantee defaultCounterAndSince:
					counter == u32"0" & 
					since_result == false;
					
			compute
				
				guarantee since_result_variable "G: Internal Variable since_result is equivalent to (not response_log_in event) Since (request_log event)":
					since_result == GUMBO_PLTL::Since(!HasEvent(analysis_report_in), HasEvent(analysis_request), In(since_result));
				
				guarantee valid1 "G: is_valid1 set correctly" :
					if (HasEvent(analysis_report_in) & HasEvent(analysis_request))
					is_valid1 == true 
					else is_valid1 == (HasEvent(analysis_report_in) ->: In(since_result));
					
				guarantee invalid2 "G: is_invalid2 set correctly" : 
					Counter(HasEvent(analysis_request), HasEvent(analysis_report_in), counter) >= u32"3";
								 
				guarantee Alert1 "G: Send an alert if more than one report is received without a request." :
					if (HasEvent(analysis_report_in) & !(is_valid1))
					MustSend(alert)
					else NoSend(alert);
				guarantee Alert2 "G: Send an alert if 3 or more requests are received without a report." :
					if (is_invalid2)
					MustSend(alert)
					else NoSend(alert);
				guarantee Forward_Report "G: Only forward a report if a valid request has been made and it is to a trusted destination." :
					if (HasEvent(analysis_report_in) & is_valid1 & !(is_invalid2) & FOUND_IN_ALLOW_LIST(ALLOW_LIST(), analysis_report_in.header.client))
					MustSend(analysis_report_out) & (analysis_report_out == analysis_report_in)
					else NoSend(analysis_report_out);	
		**};
	end reportMonitor;

	process reportMonitor_seL4
		features
			analysis_request: in event data port Common::AnalysisRequest.Impl;
			analysis_report_in: in event data port Common::AnalysisReport.Impl;
			analysis_report_out: out event data port Common::AnalysisReport.Impl;			
			alert: out event port;
		flows	
			f1: flow path analysis_request -> analysis_report_out;
			f2: flow path analysis_report_in -> analysis_report_out;
			f3: flow source alert;				
		properties
			MATRICS_Properties::Component_Type => MONITOR;			
	end reportMonitor_seL4;
	
	process implementation reportMonitor_seL4.Impl
		subcomponents
			reportMonitor: thread reportMonitor;
		connections
			c1: port analysis_request -> reportMonitor.analysis_request;
			c2: port analysis_report_in -> reportMonitor.analysis_report_in;
			c3: port reportMonitor.analysis_report_out -> analysis_report_out;
			c4: port reportMonitor.alert -> alert;
		properties
			CASE_Scheduling::Domain => 10;
		annex agree {**
			lift contract;
		**};
	end reportMonitor_seL4.Impl;
	
