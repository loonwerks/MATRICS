	-- handles encryption
	-- NOTE: Figure out what this change means.
	thread encryptor
		features
			analysis_report_in: in event data port Common::AnalysisReport.Impl;
			analysis_report_out: out event data port Common::AnalysisReport.Impl;
		flows
			f1: flow path analysis_report_in -> analysis_report_out;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
		annex agree {**
			guarantee Payload_Encrypted "G: Outgoing payload is encrypted." : 
				analysis_report_out.payload != analysis_report_in.payload;
			guarantee Header_Unencrypted "G: Outgoing header is not encrypted." : 
				analysis_report_out.header = analysis_report_in.header;
		**}	;	
		annex GUMBO {**
			compute
				guarantee Payload_Encrypted "G: Outgoing payload is encrypted." : 
					analysis_report_out.payload != analysis_report_in.payload;
				guarantee Header_Unencrypted "G: Outgoing header is not encrypted." : 
					analysis_report_out.header == analysis_report_in.header;
		**}	;
	end encryptor;
	
	process encryptor_seL4
		features
			analysis_report_in: in event data port Common::AnalysisReport.Impl;
			analysis_report_out: out event data port Common::AnalysisReport.Impl;
		flows
			f1: flow path analysis_report_in -> analysis_report_out;
		properties
			MATRICS_Properties::Component_Type => ENCRYPTOR;
	end encryptor_seL4;
	
	process implementation encryptor_seL4.Impl
		subcomponents
			encryptor: thread encryptor;
		connections
			c1: port analysis_report_in -> encryptor.analysis_report_in;
			c2: port encryptor.analysis_report_out -> analysis_report_out;
		properties
			CASE_Scheduling::Domain => 9;
		annex agree {**
			lift contract;
		**};			
	end encryptor_seL4.Impl;
	
	-- filters the analysis request to guarantee it is from a trusted device
	thread firewall
		features
			analysis_request_in: in event data port Common::AnalysisRequest.Impl;
			analysis_request_out: out event data port Common::AnalysisRequest.Impl;
		flows
			f1: flow path analysis_request_in -> analysis_request_out;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
		annex agree {**
			guarantee Forward_Request "G: Only forward a request if it is from a trusted source." :
				if event(analysis_request_in) and FOUND_IN_ALLOW_LIST(ALLOW_LIST, analysis_request_in.header.client)
				then event(analysis_request_out) and (analysis_request_out = analysis_request_in)
				else not event(analysis_request_out);
		**};
		annex GUMBO {**
			functions
				def ALLOW_LIST(): MATRICS_MODEL_Transformations::AllowList.Impl := MATRICS_MODEL_Transformations::AllowList.Impl(u32"1", u32"2", u32"3", u32"4");
				def FOUND_IN_ALLOW_LIST(allow_list: MATRICS_MODEL_Transformations::AllowList.Impl, src: Base_Types::Unsigned_32): Base_Types::Boolean :=
					(Exists(0 until allow_list.size)(i => allow_list(i) == src));				
			
			compute
				guarantee Forward_Request "G: Only forward a request if it is from a trusted source." :
					if (HasEvent(analysis_request_in) & FOUND_IN_ALLOW_LIST(ALLOW_LIST(), analysis_request_in.header.client))
					MustSend(analysis_request_out) & (analysis_request_out == analysis_request_in)
					else NoSend(analysis_request_out);
		**};
	end firewall;
	
	process firewall_seL4
		features
			analysis_request_in: in event data port Common::AnalysisRequest.Impl;
			analysis_request_out: out event data port Common::AnalysisRequest.Impl;
		flows
			f1: flow path analysis_request_in -> analysis_request_out;
		properties
			MATRICS_Properties::Component_Type => FIREWALL;
	end firewall_seL4;
	
	process implementation firewall_seL4.impl
		subcomponents
			firewall: thread firewall;
		connections
			c1: port analysis_request_in -> firewall.analysis_request_in;
			c2: port firewall.analysis_request_out -> analysis_request_out;
		properties
			CASE_Scheduling::Domain => 5;
		annex agree {**
			lift contract;
		**};			
	end firewall_seL4.impl;
	
	system wifiDriver_sys
		features
			wifiRecv: in event data port Common::IncomingWifiMessage.Impl;
			wifiSend: out event data port Common::OutgoingWifiMessage.Impl;
			HMD_log: out event data port Common::encryptedIncomingPayload.Impl;
			analysis_report: in event data port Common::AnalysisReport.Impl;
			analysis_request: out event data port Common::AnalysisRequest.Impl;
			alert: in event port;	
		flows
			f1: flow path wifiRecv -> HMD_log;
			f2: flow path wifiRecv -> analysis_Request;
			f3: flow path analysis_report -> wifiSend;	
			f4: flow sink alert;
	end wifiDriver_sys;
	
	system implementation wifiDriver_sys.Impl
		subcomponents
			wifiDriver: process wifiDriver_seL4.Impl;
			wifiDriverVM: process wifiDriverVM_seL4.Impl;
		connections
			-- Wi-Fi exchange with outside
			c1: port wifiRecv -> wifiDriverVM.wifiRecvIn;
			c2: port wifiDriverVM.wifiRecvOut -> wifiDriver.wifiRecv;
			c3: port wifiDriver.wifiSend -> wifiDriverVM.wifiSendIn;
			c4: port wifiDriverVM.wifiSendOut -> wifiSend;
			c5: port wifiDriver.HMD_log -> HMD_log;
			c6: port analysis_report -> wifiDriver.analysis_report;
			c7: port wifiDriver.analysis_request -> analysis_request;
			c8: port alert -> wifiDriver.alert;	
	end wifiDriver_sys.Impl;
	
	-- Hardened Software System
	system SW_seL4
		features
			wifiRecv: in event data port Common::IncomingWifiMessage.Impl;
			wifiSend: out event data port Common::OutgoingWifiMessage.Impl;
			--
			btRecv: in event data port Common::DummyMessage.Impl;			
			btSend: out event data port Common::DummyMessage.Impl;
			--
			usbRecv: in event data port Common::DummyMessage.Impl;			
			usbSend: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow sink wifiRecv;	
	end SW_seL4;
	
	system implementation SW_seL4.hardened
		subcomponents
			wifiDriver: system wifiDriver_sys.Impl;
			btDriver: process btDriver_seL4.Impl;
			usbDriver: process usbDriver_seL4.Impl;
			dataManager: process dataManager_seL4.Impl;
			dataAnalysis: process dataAnalysis_seL4.Impl;
			decryptor: process decryptor_seL4.Impl;
			encryptor: process encryptor_seL4.Impl;
			logMonitor: process logMonitor_seL4.Impl;
			reportMonitor: process reportMonitor_seL4.Impl;
			firewall: process firewall_seL4.Impl;
		connections
			-- Wi-Fi exchange with outside
			c1: port wifiRecv -> wifiDriver.wifiRecv;
			c2: port wifiDriver.wifiSend -> wifiSend;
			-- Bluetooth exchange with outside
			c5: port btRecv -> btDriver.btRecv;
			c6: port btDriver.btSend -> btSend;
			-- USB exchange with outside
			c7: port usbRecv -> usbDriver.usbRecv;
			c8: port usbDriver.usbSend -> usbSend;
			-- internal data communication
			c9: port dataAnalysis.request_log -> dataManager.request_log;
			-- decryption connections
			c10: port wifiDriver.HMD_log -> decryptor.HMD_log_in;
			c11: port decryptor.HMD_log_out -> dataManager.HMD_log;
			-- encryption connections
			c12: port dataAnalysis.analysis_report -> encryptor.analysis_report_in;
			c13: port reportMonitor.analysis_report_out -> wifiDriver.analysis_report;			
			-- monitor connections
			c14: port dataAnalysis.request_log -> logMonitor.request_log;
			c15: port dataManager.response_log -> logMonitor.response_log_in;
			c16: port logMonitor.response_log_out -> dataAnalysis.response_log;
			c17: port logMonitor.alert -> dataManager.zeroize;
			c18: port wifiDriver.analysis_request -> reportMonitor.analysis_request;
			c19: port encryptor.analysis_report_out -> reportMonitor.analysis_report_in;
			c20: port reportMonitor.alert -> wifiDriver.alert;
			--firewall connections
			c21: port wifiDriver.analysis_request -> firewall.analysis_request_in;
			c22: port firewall.analysis_request_out -> dataAnalysis.analysis_request;
		flows
			-- HMD log flow path
			f1: flow sink wifiRecv -> c1 -> wifiDriver.f1 -> c10 -> decryptor.f1 -> c11 -> dataManager.f1;		
	end SW_seL4.hardened;
	
end Hardened_SW;
