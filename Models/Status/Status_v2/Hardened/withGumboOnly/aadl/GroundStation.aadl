package GroundStation
public
	with Common;
	with CASE_Scheduling;
	with HAMR;
	with MATRICS_Properties;
	with MATRICS_Model_Transformations;
	renames MATRICS_Model_Transformations::all;
	with Hardened_SW;
	with Base_Types;
	
	-- Processor for Ground Station communication system
	processor Proc
		features
			sera: requires bus access Common::Serial_Bus;
		properties
			Frame_Period => 1000ms;
			Clock_Period => 1ms;
			CASE_Scheduling::Max_Domain => 15;				
	end Proc;
	
	processor implementation Proc.Impl
	end Proc.Impl;
	
	-- Virtual Processor for Ground Station communication system
	virtual processor virt_proc
	end virt_proc;
	
	
	-- Memory and storage for Ground Station communication system
	memory Mem
		features
			sera: requires bus access Common::Serial_Bus;		
	end Mem;
	
	memory implementation Mem.Impl	
	end Mem.Impl;
	
	memory Storage
		features
			sera: requires bus access Common::Serial_Bus;		
	end Storage;
	
	memory implementation Storage.Impl	
	end Storage.Impl;
	
	
	thread wifiDriver
		features
			wifiRecv: in event data port Common::IncomingWifiMessage.Impl;
			wifiSend: out event data port Common::OutgoingWifiMessage.Impl;
			HMD_log: out event data port Common::EncryptedMessage.Impl;
			analysis_report: in event data port Common::OutgoingWifiMessage.Impl;
			analysis_request: out event data port Common::AnalysisRequest.Impl;
			alert_in: in event port;
		flows
			f1: flow path wifiRecv -> HMD_log;
			f2: flow path wifiRecv -> analysis_Request;
			f3: flow path analysis_report -> wifiSend;
			f4: flow sink alert_in;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;			
		annex GUMBO{**
			state
				alert_cmd: Base_Types::Boolean;
			initialize
				modifies alert_cmd;
				
				guarantee defaultAlert:
					alert_cmd == false;
				
			compute
				modifies alert_cmd;

				assume IncomingAlert "A: A report should not be received if an alert is received." :
					HasEvent(alert_in) ->: !HasEvent(analysis_report);
				assume Trusted_Report "A: Reports received are to a trusted destination." :
					HasEvent(analysis_report) ->:
						MATRICS_Model_Transformations::FOUND_IN_ALLOW_LIST(
							analysis_report.header.client);
			
				guarantee alert_cmd_variable "G: Once an alert command is seen, always stay alerted.":
					alert_cmd == (HasEvent(alert_in) | In(alert_cmd));
				
				guarantee Process_Report "G: Stop outgoing communication once an alert has been received." :
					if (HasEvent(analysis_report) & !(alert_cmd)) 
						 MustSend(wifiSend) && (wifiSend == analysis_report)
						 else NoSend(wifiSend);
		**};
	end wifiDriver;
	
	thread dataManager
		features
			HMD_log: in event data port Common::Log.Impl;
			encrypted_log: out event data port Common::EncryptedMessage.Impl;
			request_log: in event data port Common::AnalysisRequest.Impl;
			response_log: out event data port Common::AnalysisResponse.Impl;
		flows
			f1: flow path HMD_log -> encrypted_log;
			f2: flow path request_log -> response_log;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;

	end dataManager;

	thread dataStorage
		features
			encrypted_log: in event data port Common::EncryptedMessage.Impl;
			zeroize: in event port;
			log_data: requires data access Common::EncryptedLogArray {Access_Right => read_write;};
		flows
			f1: flow sink encrypted_log;
			f2: flow sink zeroize;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
			HAMR::Microkit_Language => C;
	end dataStorage;
	
	thread dataAnalysis
		features
			request_log: out event data port Common::AnalysisRequest.Impl;
			response_log: in event data port Common::AnalysisResponse.Impl;
			analysis_report: out event data port Common::AnalysisResponse.Impl;
			analysis_request: in event data port Common::AnalysisRequest.Impl;
		flows
			f1: flow path analysis_request -> request_log;
			f2: flow path response_log -> analysis_report;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
		annex GUMBO {**
			compute
				assume Trusted_Request "A: Requests received are from a trusted source." :
					HasEvent(analysis_request) ->:
						MATRICS_Model_Transformations::FOUND_IN_ALLOW_LIST(
							analysis_request.header.client);
		**};
	end dataAnalysis;

	thread btDriver
		features
			btRecv: in event data port Common::DummyMessage.Impl;			
			btSend: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path btRecv -> btSend;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
	end btDriver;
	
	thread usbDriver
		features
			usbRecv: in event data port Common::DummyMessage.Impl;
			usbSend: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path usbRecv -> usbSend;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
	end usbDriver;

	-- The Ground Station communication system
	system GroundStation
		features
			wifiRecv: in event data port Common::IncomingWifiMessage.Impl;
			wifiSend: out event data port Common::OutgoingWifiMessage.Impl;
			btSend: out event data port Common::DummyMessage.Impl;
			btRecv: in event data port Common::DummyMessage.Impl;
			usbRecv: in event data port Common::DummyMessage.Impl;
			usbSend: out event data port Common::DummyMessage.Impl;
			wfa: requires bus access Common::WF_Bus;
			bta: requires bus access Common::BT_Bus;					
		flows
			f1: flow sink wifiRecv;
	end GroundStation;
	
	system implementation GroundStation.Impl
		subcomponents
			wifi: device Common::Wifi.Impl;
			bluetooth: device Common::Bluetooth.Impl;
			usb: device Common::USB.Impl;
			cpu: processor Proc.Impl;
			vcpu: virtual processor virt_proc;
			mem: memory Mem.Impl;
			storage: memory Storage.Impl;
			ser1: bus Common::Serial_Bus.Impl;
			ser2: bus Common::Serial_Bus.Impl;
			ser3: bus Common::Serial_Bus.Impl;
			ser4: bus Common::Serial_Bus.Impl;			
			cpuSw: system Hardened_SW::SW_seL4.hardened;
		connections
			-- Processor connected to memory and storage
			bac1: bus access mem.sera <-> ser1;
			bac2: bus access cpu.sera <-> ser1;
			bac3: bus access storage.sera <-> ser1;			
			-- Wi-Fi connected to CPU
			bac4: bus access wifi.sera <-> ser2;
			bac5: bus access cpu.sera <-> ser2;
			-- Bluetooth connected to CPU
			bac6: bus access bluetooth.sera <-> ser3;
			bac7: bus access cpu.sera <-> ser3;			
			-- USB connected to CPU
			bac8: bus access usb.sera <-> ser4;
			bac9: bus access cpu.sera <-> ser4;
			-- Wi-Fi connected to the outside			
			bac10: bus access wifi.wfa <-> wfa;
			-- Bluetooth connected to the outside			
			bac11: bus access bluetooth.bta <-> bta;
			--
			c1: port cpuSw.wifiSend -> wifi.sendIn;
			c2: port wifi.sendOut -> wifiSend;
			c3: port wifiRecv -> wifi.recvIn;
			c4: port wifi.recvOut -> cpuSw.wifiRecv;
			c5: port bluetooth.recvOut -> cpuSw.btRecv;
			c6: port cpuSW.btSend -> bluetooth.sendIn;
			c7: port bluetooth.sendOut -> btSend;
			c8: port btRecv -> bluetooth.recvIn; 
			c9: port usb.recvOut -> cpuSW.usbRecv;
			c10: port cpuSW.usbSend -> usb.sendIn;
			c11: port usbRecv -> usb.recvIn;
			c12: port usb.sendOut -> usbSend;	
		flows
			f1: flow sink wifiRecv -> c3 -> wifi.f1 -> c4 -> cpuSw.f1; 
		properties
			Actual_Processor_Binding => (reference (vcpu)) applies to cpuSw.wifiDriver.wifiDriverVM, cpuSw.dataManager.dataStorage;
			Actual_Processor_Binding => (reference (cpu)) applies to cpuSw, vcpu;
			Actual_Connection_Binding => (reference (ser2)) applies to c1, c4;
			MATRICS_Properties::Memory_Type => RAM applies to mem;
			MATRICS_Properties::Memory_Type => ON_DISK applies to storage;			
			Actual_Memory_Binding => (reference (storage)) applies to cpuSW.dataManager.dataStorage.logs;
			
			-- present in hardened system
			MATRICS_Properties::OS => "seL4" applies to cpu;
			HAMR::Platform => (Microkit);
			HAMR::Microkit_Language => Rust;
	end GroundStation.Impl;
	
end GroundStation;
