package MATRICS_Model_Transformations
public
	with Base_Types;
	with Common;
	
	annex GUMBO {**
          functions
               def FOUND_IN_ALLOW_LIST(
                    src: Base_Types::Unsigned_32): Base_Types::Boolean :=
					src == u32"3232235877" ||
					src == u32"3232235878" ||
					src == u32"3232235879" ||
					src == u32"3232235880";
                    
               def IS_NULL_LOG(log: Common::Log.Impl): Base_Types::Boolean :=
					(log.timestamp == u32"0" &&
					log.userID == u32"0" &&
					log.numSuspects == u32"0" &&
					log.numSuspectsFlagged == u32"0" &&
					log.yaw == s32"0" &&
					log.pitch == s32"0" &&
					log.roll == s32"0");
	**};
	
end MATRICS_Model_Transformations;
