package MATRICS_Model_Transformations
public
	with Data_Model;
	with Base_Types;
	with Common;
	with HAMR;
	with MATRICS_Properties;
	
	-- Allow list that establishes set of trusted devices
	data AllowList
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_32));
			Data_Model::Dimension => (4);
			Memory_Properties::Data_Size => 16 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end AllowList;
	
	data implementation AllowList.Impl
	end AllowList.Impl;
	
	annex GUMBO {**
          functions
               def ALLOW_LIST(): MATRICS_Model_Transformations::AllowList.Impl :=
                    MATRICS_Model_Transformations::AllowList.Impl(
                         u32"3232235877", u32"3232235878", u32"3232235879", u32"3232235880");

               def FOUND_IN_ALLOW_LIST(
                    allow_list: MATRICS_Model_Transformations::AllowList.Impl,
                    src: Base_Types::Unsigned_32): Base_Types::Boolean :=
                    (Exists(0 until allow_list.size)(i => allow_list(i) == src));
                    
               def NULL_LOG(): Common::Log.Impl := Common::Log.Impl
					{timestamp = 0;
					 userID = 0;
					 numSuspects = 0;
					 numSuspectsFlagged = 0;
					 yaw = 0;
					 pitch = 0;
					 roll = 0
					};
	**};
	
end MATRICS_Model_Transformations;
