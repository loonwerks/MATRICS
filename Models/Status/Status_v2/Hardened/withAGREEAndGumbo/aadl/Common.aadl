package Common
public
	with Data_Model;
	with Base_Types;
	with HAMR;
	with MATRICS_Properties;

	-- Wi-Fi: range 150ft, higher data transfer and power consumption than Bluetooth
	bus WF_Bus
	end WF_Bus;

	bus implementation WF_Bus.Impl
	end WF_Bus.Impl;
	
	-- Bluetooth: range 150ft, lower data transfer and power consumption than Bluetooth
	bus BT_Bus
	end BT_Bus;

	bus implementation BT_Bus.Impl
	end BT_Bus.Impl;

	bus Serial_Bus
	end Serial_Bus;

	bus implementation Serial_Bus.Impl
	end Serial_Bus.Impl;
	
	
	-- Wi-Fi hardware
	device Wifi
		features
			sera: requires bus access Serial_Bus;
			wfa: requires bus access WF_Bus;
			recvIn: in event data port Common::IncomingWifiMessage.Impl;
			recvOut: out event data port Common::IncomingWifiMessage.Impl;
			sendIn: in event data port Common::OutgoingWifiMessage.Impl;
			sendOut: out event data port Common::OutgoingWifiMessage.Impl;
		flows
			f1: flow path recvIn -> recvOut;
			f2: flow path sendIn -> sendOut;
	end Wifi;
	
	device implementation Wifi.Impl	
	end Wifi.Impl;
	
	-- Bluetooth hardware
	device Bluetooth
		features
			sera: requires bus access Serial_Bus;
			bta: requires bus access BT_Bus;
			recvIn: in event data port Common::DummyMessage.Impl;
			recvOut: out event data port Common::DummyMessage.Impl;
			sendIn: in event data port Common::DummyMessage.Impl;
			sendOut: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path recvIn -> recvOut;
			f2: flow path sendIn -> sendOut;
	end Bluetooth;
	
	device implementation Bluetooth.Impl	
	end Bluetooth.Impl;
	
	-- USB hardware
	device USB
		features
			sera: requires bus access Serial_Bus;
			recvIn: in event data port Common::DummyMessage.Impl;
			recvOut: out event data port Common::DummyMessage.Impl;
			sendIn: in event data port Common::DummyMessage.Impl;
			sendOut: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path recvIn -> recvOut;
			f2: flow path sendIn -> sendOut;
	end USB;
	
	device implementation USB.Impl
	end USB.Impl;
	
	-- Custom SW handling Wi-Fi and Bluetooth communication, interacting with other SW via IPC
	process Com_SW
		features
			ipcDataIn: in data port;
			ipcDataOut: out data port;
			wfComIn: in data port;
			wfComOut: out data port;
			btComIn: in data port;
			btComOut: out data port;
		flows
			f1: flow path wfComIn -> ipcDataOut;
			f2: flow path ipcDataIn -> wfComOut;
			f3: flow path btComIn -> ipcDataOut;
			f4: flow path ipcDataIn -> btComOut;
	end Com_SW;
	
	process implementation Com_SW.Impl
	end Com_SW.Impl;
	
	
	-- To represent communication between native and custom software
	virtual bus IPC_Com
	end IPC_Com;
	
	virtual bus implementation IPC_Com.Impl
	end IPC_Com.Impl;
	
	-- To represent TCP protocol
	virtual bus TCP
	end TCP;
	
	virtual bus implementation TCP.Impl
	end TCP.Impl;
	

	data MsgHeader
	end MsgHeader;

	data implementation MsgHeader.Impl
		subcomponents
			client: data Base_Types::Unsigned_32;
	end MsgHeader.Impl;
	
	-- Classification assigned by the guard to an HMD target.
	data TargetAssessment
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators => ("Unreviewed", "Safe", "Threat");
	end TargetAssessment;

	-- HMD position and orientation. Positions are signed millimeters. Quaternion
	-- components are signed fixed-point values scaled by 1,000,000.
	data HMDPosition
	end HMDPosition;

	data implementation HMDPosition.Impl
		subcomponents
			positionX: data Base_Types::Integer_32;
			positionY: data Base_Types::Integer_32;
			positionZ: data Base_Types::Integer_32;
			orientationX: data Base_Types::Integer_32;
			orientationY: data Base_Types::Integer_32;
			orientationZ: data Base_Types::Integer_32;
			orientationW: data Base_Types::Integer_32;
	end HMDPosition.Impl;

	-- One HMD target observation. Locations are signed millimeters relative to the HMD position.
	data TargetObservation
	end TargetObservation;

	data implementation TargetObservation.Impl
		subcomponents
			targetID: data Base_Types::Unsigned_32;
			locationX: data Base_Types::Integer_32;
			locationY: data Base_Types::Integer_32;
			locationZ: data Base_Types::Integer_32;
			assessment: data TargetAssessment;
	end TargetObservation.Impl;


	data TargetObservationArray
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (TargetObservation.Impl));
			Data_Model::Dimension => (MATRICS_Properties::MAX_TARGETS_PER_LOG);
			-- TargetObservation.Impl is 20 bytes: four 32-bit integer
			-- fields plus the 4-byte TargetAssessment enum. Therefore,
			-- MAX_TARGETS_PER_LOG (15) * 20 bytes = 300 bytes.
			Memory_Properties::Data_Size => 300 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end TargetObservationArray;

	data implementation TargetObservationArray.Impl
	end TargetObservationArray.Impl;

	-- One periodically produced HMD observation.
	data Log
	end Log;
	
	data implementation Log.Impl
		subcomponents
			-- Milliseconds in the deployment-defined common time base.
			timestamp: data Base_Types::Unsigned_64;
			guardID: data Base_Types::Unsigned_32;
			deviceID: data Base_Types::Unsigned_32;
			hmdPosition: data HMDPosition.Impl;
			targetCount: data Base_Types::Unsigned_32;
			targets: data TargetObservationArray.Impl;
	end Log.Impl;

	data AnalysisRequest
	end AnalysisRequest;
	
	data AnalysisType
		properties
			Data_Model::Data_Representation => Enum;
			Data_Model::Enumerators =>
				("All_Records", "Threat_Only", "Safe_Only", "Unreviewed_Only", "Target_History");
	end AnalysisType;

	data Request
	end Request;
	
	data implementation Request.Impl
		subcomponents
			analysisType: data AnalysisType;
			guardID: data Base_Types::Unsigned_32;
			-- Inclusive millisecond bounds in the same time base as Log.timestamp.
			startTime: data Base_Types::Unsigned_64;
			endTime: data Base_Types::Unsigned_64;
			-- Used when analysisType is Target_History.
			targetID: data Base_Types::Unsigned_32;
	end Request.Impl;
	
	data implementation AnalysisRequest.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data Request.Impl;
	end AnalysisRequest.Impl;
	
	-- Response log message structure
	data AnalysisResponse
	end AnalysisResponse;
	
	data Response
	end Response;
	
	data implementation Response.Impl
		subcomponents
			-- Echoes the criteria so the response remains self-contained as it
			-- traverses separately scheduled components.
			request: data Request.Impl;
			validLogCount: data Base_Types::Unsigned_32;
			-- When true, nextStartTime is the timestamp of the first applicable
			-- log omitted from this bounded response.
			moreAvailable: data Base_Types::Boolean;
			nextStartTime: data Base_Types::Unsigned_64;
			logs: data ResponseLog.Impl;
	end Response.Impl;
	
	data ResponseLog
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Log.Impl));
			Data_Model::Dimension => (MATRICS_Properties::MAX_LOGS_PER_RESPONSE);
			-- Log.Impl is 352 bytes: 348-bytes of fields plus 4 bytes 
			-- of tail padding for 8-byte alignment. Therefore, 
			-- MAX_LOGS_PER_RESPONSE (10) * 352 bytes = 3520 bytes.
			Memory_Properties::Data_Size => 3520 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end ResponseLog;
	
	data implementation ResponseLog.Impl
	end ResponseLog.Impl;

	data implementation AnalysisResponse.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data Response.Impl;
	end AnalysisResponse.Impl;
	
	data DummyMessage
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (100);
			Memory_Properties::Data_Size => 100 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end DummyMessage;
	
	data implementation DummyMessage.Impl
	end DummyMessage.Impl;
	
	data Nonce
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (12);
			Memory_Properties::Data_Size => 12 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end Nonce;
	
	data implementation Nonce.Impl
	end Nonce.Impl;
	
	data Ciphertext
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (4068);
			-- Fixed 4096-byte encrypted frame minus 12-byte nonce and 16-byte tag:
			-- 4096 - 12 - 16 = 4068 bytes of ciphertext. This accommodates the
			-- bounded Response.Impl payload and its serialization overhead.
			Memory_Properties::Data_Size => 4068 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end Ciphertext;
	
	data implementation Ciphertext.Impl
	end Ciphertext.Impl;

	data AuthenticationTag
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (16);
			Memory_Properties::Data_Size => 16 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end AuthenticationTag;

	data implementation AuthenticationTag.Impl
	end AuthenticationTag.Impl;

	data EncryptedMessage
	end EncryptedMessage;

	data implementation EncryptedMessage.Impl
		subcomponents
			nonce: data Nonce.Impl;
			ciphertext: data Ciphertext.Impl;
			tag: data AuthenticationTag.Impl;
		properties
			-- 12-byte nonce + 4068-byte ciphertext + 16-byte tag = 4096 bytes.
			Memory_Properties::Data_Size => 4096 Bytes;
	end EncryptedMessage.Impl;

	-- Plaintext fields used to construct and index the filename for one encrypted
	-- HMD log. A representative filename is
	-- g<guardID>_d<deviceID>_t<timestamp>.hmdlog.
	-- This tuple is unique when a guard has one active device and that device
	-- produces at most one log per millisecond in the persistent common time base.
	-- These fields are indexable by dataStorage without decryption.
	data LogFileMetadata
	end LogFileMetadata;

	data implementation LogFileMetadata.Impl
		subcomponents
			guardID: data Base_Types::Unsigned_32;
			deviceID: data Base_Types::Unsigned_32;
			timestamp: data Base_Types::Unsigned_64;
	end LogFileMetadata.Impl;

	-- One indexable file containing exactly one encrypted HMD Log.Impl value.
	data StoredLogFile
	end StoredLogFile;

	data implementation StoredLogFile.Impl
		subcomponents
			metadata: data LogFileMetadata.Impl;
			encryptedLog: data EncryptedMessage.Impl;
	end StoredLogFile.Impl;

	data EncryptedLogArray
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (StoredLogFile.Impl));
			Data_Model::Dimension => (100);
			-- StoredLogFile.Impl is 4112 bytes: 16-byte metadata plus 4096-byte
			-- encrypted frame. Therefore, 100 files * 4112 bytes = 411200 bytes.
			-- This array models on-disk data accessed by dataStorage; it is not
			-- transmitted as a port message.
			Memory_Properties::Data_Size => 411200 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end EncryptedLogArray;

	data implementation EncryptedLogArray.Impl
	end EncryptedLogArray.Impl;

	-- Indexable encrypted files returned by dataStorage for one analysis response.
	-- Unlike EncryptedLogArray, this is an event-data message rather than on-disk storage.
	data EncryptedResponseLog
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (StoredLogFile.Impl));
			Data_Model::Dimension => (MATRICS_Properties::MAX_LOGS_PER_RESPONSE);
			-- StoredLogFile.Impl records is 4112 bytes: 16-byte metadata
			-- plus 4096-byte encrypted frame. Therefore, 
			-- MAX_LOGS_PER_RESPONSE (10) * 4112 bytes = 41120 bytes.
			Memory_Properties::Data_Size => 41120 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end EncryptedResponseLog;

	data implementation EncryptedResponseLog.Impl
	end EncryptedResponseLog.Impl;

	-- Self-contained encrypted storage result. The request criteria and client
	-- header remain plaintext so independently scheduled components do not need
	-- to retain them as state.
	data EncryptedResponse
	end EncryptedResponse;

	data implementation EncryptedResponse.Impl
		subcomponents
			request: data Request.Impl;
			validLogCount: data Base_Types::Unsigned_32;
			moreAvailable: data Base_Types::Boolean;
			nextStartTime: data Base_Types::Unsigned_64;
			logs: data EncryptedResponseLog.Impl;
	end EncryptedResponse.Impl;

	data EncryptedAnalysisResponse
	end EncryptedAnalysisResponse;

	data implementation EncryptedAnalysisResponse.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data EncryptedResponse.Impl;
	end EncryptedAnalysisResponse.Impl;
	
	data shortText
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Character));
			Data_Model::Dimension => (64);
			-- 64 characters * 1 byte per modeled character = 64 bytes.
			Memory_Properties::Data_Size => 64 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end shortText;
	
	data implementation shortText.Impl
	end shortText.Impl;
	
		
	data IncomingWifiHeader
	end IncomingWifiHeader;

	data implementation IncomingWifiHeader.Impl
		subcomponents
			route: data shortText;
			client: data Base_Types::Unsigned_32;
	end IncomingWifiHeader.Impl;
	
	data IncomingWifiMessage
	end IncomingWifiMessage;
	
	data implementation IncomingWifiMessage.Impl
		subcomponents
			header: data IncomingWifiHeader.Impl;
			payload: data EncryptedMessage.Impl;
	end IncomingWifiMessage.Impl;
	
	data OutgoingWifiMessage
	end OutgoingWifiMessage;
	
	data implementation OutgoingWifiMessage.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data EncryptedMessage.Impl;
	end OutgoingWifiMessage.Impl;
		
end Common;
