package MATRICS_Model_Transformations
public
	with Data_Model;
	with Base_Types;
	with Common;
	with HAMR;
	with MATRICS_Properties;
	
	-- Allow list that establishes set of trusted devices
	data AllowList
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_32));
			Data_Model::Dimension => (4);
			Memory_Properties::Data_Size => 16 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end AllowList;
	
	data implementation AllowList.Impl
	end AllowList.Impl;
	
	annex agree {**
		-- Allow 192.168.1.101, 192.168.1.102, 192.168.1.103, and 192.168.1.104,
		-- expressed as octet arithmetic because AGREE's decimal-literal parser is
		-- limited to signed 32-bit values even when the target type is Unsigned_32.
		const ALLOW_LIST: AllowList.Impl = [|
			192 * 16777216 + 168 * 65536 + 1 * 256 + 101,
			192 * 16777216 + 168 * 65536 + 1 * 256 + 102,
			192 * 16777216 + 168 * 65536 + 1 * 256 + 103,
			192 * 16777216 + 168 * 65536 + 1 * 256 + 104
		|];
			
		fun FOUND_IN_ALLOW_LIST(allow_list: AllowList.Impl, src: Base_Types::Unsigned_32): bool = 
			exists i in allow_list, i = src;

		uninterpreted AES_128_GCM_DECRYPT_LOG(
			message: Common::EncryptedMessage.Impl): Common::Log.Impl;

		uninterpreted AES_128_GCM_ENCRYPTS_RESPONSE(
			response: Common::Response.Impl,
			encrypted: Common::EncryptedMessage.Impl): bool;
			
		const NULL_LOG: Common::Log.Impl = Common::Log.Impl
			{timestamp = 0;
			 userID = 0;
			 numSuspects = 0;
			 numSuspectsFlagged = 0;
			 yaw = 0;
			 pitch = 0;
			 roll = 0
			};
	**};
	
	annex GUMBO {**
          functions
			def FOUND_IN_ALLOW_LIST(
				src: Base_Types::Unsigned_32): Base_Types::Boolean :=
				src == u32"3232235877" ||
				src == u32"3232235878" ||
				src == u32"3232235879" ||
				src == u32"3232235880";

			def IS_NULL_LOG(log: Common::Log.Impl): Base_Types::Boolean :=
				log.timestamp == u32"0" &&
				log.userID == u32"0" &&
				log.numSuspects == u32"0" &&
				log.numSuspectsFlagged == u32"0" &&
				log.yaw == s32"0" &&
				log.pitch == s32"0" &&
				log.roll == s32"0";
	**};

	annex Resolute {**
		
		---------------------------
		-- MODEL TRANSFORMATIONS --
		---------------------------
		
		-- Top-level claim for proper insertion of a firewall
		is_firewalled(comp_context : component, conn : connection, msg_type : data) <=
			** "Firewall is properly added to component " comp_context **
			let firewalls : {component} = upstream_trusted_components(comp_context, "FIREWALL");
			exists(f : firewalls) . (firewall_exists(f, comp_context, conn) and component_not_bypassed(f, comp_context, msg_type))
		
		-- Top-level claim for proper insertion of a monitor
		is_monitored(comp_context : component, monitor : component) <=
			** "Monitor " monitor " is properly added to " comp_context **
			component_exists(monitor, "MONITOR") and alert_connected(monitor)

		-- Top-level claim for proper insertion of a monitor with a gate
		is_monitored_gated(comp_context : component, gate_context : component, msg_type : data) <=
			** "Monitor is properly added to component " comp_context **
			let monitors : {component} = upstream_trusted_components(gate_context, "MONITOR");
			exists(m : monitors) . (alert_connected(m) and component_not_bypassed(m, gate_context, msg_type))
		
		-- Top-level claim that a component is built for seL4
		is_seL4_compliant(comp_context : component) <=
			** "Component " comp_context " is built for seL4" **
			is_seL4_component(comp_context) and each_thread_in_separate_process(comp_context)
			
		-- Top-level claim that communication channel is encrypted
		is_communication_encrypted(comp_context1 : component, comp_context2 : component) <=
			** "All communication between " comp_context1 " and " comp_context2 " is encrypted" **
			let conns : {connection} = intersect(connections(comp_context1), connections(comp_context2));
			forall (c : conns) . is_encrypted_protocol(c)
			
		is_encrypted_protocol(conn : connection) : bool =
			let buses : {component} = {c for (c : component) | is_bound_to_bus(conn, c)};
			(size(buses) > 0) and forall (b : buses) . (has_property(b, MATRICS_Properties::Encrypted))		
			
		is_bound_to_bus(c : connection, b : component) : bool =
			is_bound_to(c, b) and (is_virtual_bus(b) or is_bus(b))
		
		-- Top-level claim that message has been encrypted
		is_message_encrypted(comp_context : component, msg_type : data) <=
			** "Message " msg_type " on component " comp_context " is encrypted" **
			let srcs : {component} = get_sources_by_type(comp_context, msg_type, "ENCRYPTOR");
			srcs <> {} and not(exists(s : srcs) . is_of_matrics_type(s, "DECRYPTOR"))
			
		-- Returns the set of components that are ancestors of a target component through communication pathways for a given data type
		get_sources_by_type(comp_context : component, msg_type : data, matrics_type : string) : {component} = 
			let srcs : {component} = {c for (conn : connections (comp_context)) (c : source_component(conn)) | has_type(conn) and type(conn) = msg_type}; 
			recursive_backwards_reach_by_type(srcs, msg_type, matrics_type)						
				
		recursive_backwards_reach_by_type(curr : {component}, msg_type : data, matrics_type : string) : {component} = 
			let prev : {component} = union(curr, prev_reach_by_type(curr, msg_type)); 
			if exists(c : prev) . is_of_matrics_type(c, matrics_type) then
				curr
			else 
				if prev = curr then 
					{}
			else 
				recursive_backwards_reach_by_type(prev, msg_type, matrics_type)				
				
		prev_reach_by_type(curr : {component}, msg_type : data) : {component} = 
			{y for (x : curr) (y : backwards_reachable_components_by_type(x, msg_type))}				
				
		backwards_reachable_components_by_type(comp : component, msg_type : data) : {component} = 
			{c for (conn : connections (comp)) (c : backwards_reachable_components_via_connection_by_type(comp, conn, msg_type))}				
				
		backwards_reachable_components_via_connection_by_type(comp : component, conn : connection, msg_type : data) : {component} =
			if is_port_connection(conn) and has_type(conn) and type(conn) = msg_type then
				if destination_component(conn) = comp and has_parent(source_component(conn)) then
					{source_component(conn)}
				else
					{}
			else
				{}
				
		-- Top-level claim that a component only communicates with a particular communication driver
		uses_authorized_communication(comp_context : component, comm_driver : component) <=		
			** "Component " comp_context " only communicates using " comm_driver " communication driver" **
			let srcs : {component} = recursive_backwards_reach({comp_context, comm_driver});
			let comm_driver_srcs : {component} = {s for (s : srcs) | is_of_matrics_type(s, "COMM_DRIVER")};
			comm_driver_srcs = {comm_driver}
		
		-- Top-level claim that confidential data is only accessible via a trusted component and is encrypted if stored on-disk
		confidential_data_secure_storage(comp_context : component, trusted_comp : component) <=
			** "Confidential data is only accessible by " trusted_comp " and is encrypted if stored on-disk" **
			let comps : {component} = get_subcomponents({comp_context});			
			let confidential_data : {component} = {comp for (comp : comps) | 
				has_property(comp, MATRICS_Properties::Requires_Data_Confidentiality) 
				and property(comp, MATRICS_Properties::Requires_Data_Confidentiality)
			};
			forall (d : confidential_data) . trusted_data_access(d, trusted_comp)
		
		-- Checks if a data component is stored on-disk then it is encrypted
		data_secured(d : component) : bool =
			let mem : {memory} = {m for (m : memory) | is_stored_on_disc(d, m)};
			size(mem) > 0 => has_property(d, MATRICS_Properties::Encrypted)
			
		is_stored_on_disc(d : component, m : memory) : bool =
			is_bound_to(d, m) and has_property(m, MATRICS_Properties::Memory_Type) and property(m, MATRICS_Properties::Memory_Type) = "ON_DISK"
	
		-- Checks if a data component is associated with only one trusted component and that that data is secured
		trusted_data_access(d : component, trusted_comp : component) : bool =
			let conns : {connection} = {c for (c : connection) | is_data_access_connection(c) and source(c) = d and is_destination_component(c, trusted_comp)};
			size(conns) = 1 and data_secured(source_component(head(as_list(conns))))

		----------------
		-- SUB CLAIMS --
		----------------	
		
		-- Check to see if there is a firewall immediately before 
		-- the component on the communication pathway.
		firewall_exists(firewall : component, comp_context : component, conn : connection) <=
			** "A firewall " firewall " is connected to component " comp_context " by connection " conn **
			let conns : {connection} = {c for (c : connections(comp_context)) | destination_component(c) = comp_context and source_component(c) = firewall};
			is_of_matrics_type(firewall, "FIREWALL") and exists(c : conns) . c = conn
						
		-- Check to see if the specified component exists
		component_exists(comp : component, matrics_type : string) <=
			** comp " exists in the model" **
			is_of_matrics_type(comp, matrics_type) and exists(m : component) . m = comp
			
		upstream_trusted_components(comp : component, matrics_type : string) : {component} =
			let input_ports : {feature} = {p for (p : features(comp)) | direction(p) = "in"};
			let input_conns : {connection} = {c for (p : input_ports) (c : connection) | destination(c) = p};
			{s for (c: input_conns) (s : component) | source_component(c) = s and has_property(s, MATRICS_Properties::Component_Type) and (property(s, MATRICS_Properties::Component_Type) = matrics_type)}

		-- Make sure there is no communication pathway that avoids the component
		component_not_bypassed(comp : component, comp_context : component, msg_type : data) <=
			** "Component " comp " cannot be bypassed" **
			let comp_srcs : {component} = get_filter_sources(comp_context, comp, msg_type); 
			let non_comp_srcs : {component} = get_non_filter_sources(comp_context, comp, msg_type); 
			size(intersect(comp_srcs, non_comp_srcs)) = 0
			
		is_of_matrics_type(comp : component, type_name : string) : bool =
			has_property(comp, MATRICS_Properties::Component_Type) and property(comp, MATRICS_Properties::Component_Type) = type_name
			
		-- Returns the set of components that are ancestors of a target component through communication pathways that don't pass through a filter
		get_non_filter_sources(target : component, filter : component, msg_type : data) : {component} = 
			let srcs : {component} = {c for (conn : connections (target)) (c : source_component(conn)) | has_type(conn) and type(conn) = msg_type and not (source_component(conn) = filter) and not (source_component(conn) = target)}; 
			recursive_backwards_reach(srcs)
		
		-- Returns the set of components that are ancestors of the filter on a target component
		get_filter_sources(target : component, filter : component, msg_type : data) : {component} = 
			let srcs : {component} = {c for (conn : connections(target)) (c : source_component(conn)) | has_type(conn) and type(conn) = msg_type and name(source_component(conn)) = name(filter)};
			prev_reach(srcs)
		
		recursive_backwards_reach(curr : {component}) : {component} = 
			let prev : {component} = union(curr, prev_reach(curr)); 
			if prev = curr then 
				curr
			else 
				recursive_backwards_reach(prev)
		
		prev_reach(curr : {component}) : {component} = 
			{y for (x : curr) (y : backwards_reachable_components(x))}
		
		backwards_reachable_components(comp : component) : {component} = 
			{c for (conn : connections (comp)) (c : backwards_reachable_components_via_connection(comp, conn))}		
		
		backwards_reachable_components_via_connection(comp : component, conn : connection) : {component} = 
			if is_port_connection(conn) then 
				if destination_component(conn) = comp and has_parent(source_component(conn)) then
					{source_component(conn)} 
				else 
					{} 
			else 
				{}
				
		is_bound_to_processor(c : component, p : component) : bool =
			is_bound_to(c, p) and (is_processor(p) or is_virtual_processor(p))
						
		alert_connected(monitor : component) <=
			** "Monitor Alert port is connected" **
			let alert_ports : {feature} = {p for (p : features(monitor)) |
				name(p) = "alert_out"};
			let alert_conns : {connection} = {c for (p : alert_ports) (c : connection) | source(c) = p};
			length(alert_conns) > 0

		-- checks that a component will run on seL4 by checking that the processors it is bound to have the seL4 OS property		
		is_seL4_component(comp : component) : bool =
			let proc : {component} = {c for (c : component) | is_bound_to_processor(comp, c)};
			(size(proc) > 0) and forall (p : proc) . (has_property(p, MATRICS_Properties::OS) and property(p, MATRICS_Properties::OS) = "seL4")
			
		-- Get set of descendants
		get_subcomponents(curr : {component}) : {component} =
			let next : {component} = union(curr, next_subcomponent(curr));
			if next = curr then
				curr
			else
				get_subcomponents(next)
			
		next_subcomponent(curr : {component}) : {component} =
			{y for (x : curr) (y : subcomponents(x))}
			
		thread_subcomponents(comp : component) : {component} =
			let threads : {component} = {s for (s : subcomponents(comp)) | is_thread(s)};
			threads
			
		each_thread_in_separate_process(root : component) <=
			** "Each thread runs in a separate process" **
			let comps : {component} = get_subcomponents({root});
			forall (c : comps) . is_process(c) => length(thread_subcomponents(c)) = 1
		
	**};
	
end MATRICS_Model_Transformations;
