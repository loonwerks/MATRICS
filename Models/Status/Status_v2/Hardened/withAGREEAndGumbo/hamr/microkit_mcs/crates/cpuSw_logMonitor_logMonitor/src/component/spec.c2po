-- Do not edit this file as it will be overwritten if HAMR codegen is rerun

INPUT
	api_response_log_in_nonEmpty: bool;
	api_request_log_nonEmpty: bool;



PTSPEC
	-- G: No more than one reponse is received per request (only looks back 365 days)
	No_Response_Without_Request: api_response_log_in_nonEmpty ->
	    api_request_log_nonEmpty || (!api_response_log_in_nonEmpty S[1,31536000] api_request_log_nonEmpty);
	-- G: No alert was ever sent (time out after one year)
	Historically_No_Alert: H[0,31536000](api_response_log_in_nonEmpty ->
	    api_request_log_nonEmpty || (!api_response_log_in_nonEmpty S[1,31536000] api_request_log_nonEmpty));


