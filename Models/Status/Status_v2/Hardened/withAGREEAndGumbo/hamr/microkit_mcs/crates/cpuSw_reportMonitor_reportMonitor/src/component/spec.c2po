-- Do not edit this file as it will be overwritten if HAMR codegen is rerun

INPUT
	api_analysis_report_in_nonEmpty: bool;
	api_analysis_request_nonEmpty: bool;
	counter: int;



PTSPEC
	-- G: A report is not received without a valid request and no more than three requests are received without a report (only looks back 365 days)
	Valid_Response_Request_Behavior: (api_analysis_report_in_nonEmpty ->
	    api_analysis_request_nonEmpty || (!api_analysis_report_in_nonEmpty S[1,31536000] api_analysis_request_nonEmpty)) ||
	    (counter >= 3);
	-- G: A valid request has been made (only looks back 365 days)
	Valid_And_Trusted_Report: api_analysis_report_in_nonEmpty &&
	    (api_analysis_request_nonEmpty || (!api_analysis_report_in_nonEmpty S[1,31536000] api_analysis_request_nonEmpty)) &&
	    (counter < 3);


