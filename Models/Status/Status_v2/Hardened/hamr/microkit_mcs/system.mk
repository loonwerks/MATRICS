# Do not edit this file as it will be overwritten if HAMR codegen is rerun

ifeq ($(strip $(LIONSOS)),)
$(error LIONSOS must be specified)
endif
override LIONSOS:=$(abspath ${LIONSOS})


# Metaprogram that generates the system description file.
# Override to use an alternative schedule (e.g. monitor.mk).
MSD ?= $(TOP_DIR)/meta.py

# Header files containing config structs whose sizes the sdfgen helper
# needs to calculate. Override to point at a different config header.
SCHEDULER_CONFIG_HEADERS ?= $(TOP_DIR)/scheduler/include/default.user_config.h

# Scheduler C source file compiled into scheduler.elf.
# Override to substitute a different scheduler implementation
# (e.g. one that publishes schedule state for runtime monitoring).
SCHEDULER_C ?= $(TOP_DIR)/scheduler/src/default.scheduler.c


TOOLCHAIN := clang
CC := clang
LD := ld.lld
RANLIB := llvm-ranlib
AR := llvm-ar
OBJCOPY := llvm-objcopy
MICROKIT_TOOL ?= $(MICROKIT_SDK)/bin/microkit
DTC := dtc
PYTHON ?= python3
SDDF := $(LIONSOS)/dep/sddf

SYSTEM_FILE := arinc_scheduling.system
IMAGE_FILE := loader.img
REPORT_FILE := report.txt

SUPPORTED_BOARDS := qemu_virt_aarch64 rpi4b_4gb

include ${SDDF}/tools/make/board/common.mk

SDFGEN_HELPER := $(TOP_DIR)/sdfgen_helper.py

# Macros needed by sdfgen helper to calculate config struct sizes
SDFGEN_UNKOWN_MACROS := MAX_PARTITIONS=61 MAX_SCHEDULE_SLOTS=128

SDDF_CUSTOM_LIBC := 1

LDFLAGS := -L$(BOARD_DIR)/lib -L$(SDDF)/lib
LIBS := -lmicrokit -Tmicrokit.ld libsddf_util_debug.a

SDDF_MAKEFILES := ${SDDF}/util/util.mk \
	${SDDF}/drivers/timer/${TIMER_DRIV_DIR}/timer_driver.mk \
	${SDDF}/drivers/serial/${UART_DRIV_DIR}/serial_driver.mk \
	${SDDF}/serial/components/serial_components.mk

include ${SDDF_MAKEFILES}


CFLAGS += \
	-I$(LIONSOS)/include \
	-I$(SDDF)/include \
	-I$(SDDF)/include/microkit \
	-I$(TOP_DIR)/scheduler/include \
	-I$(TOP_DIR)/types/include \
	-I$(TOP_DIR)/components/cpuSw_btDriver_btDriver/include \
	-I$(TOP_DIR)/components/cpuSw_usbDriver_usbDriver/include \
	-I$(TOP_DIR)/components/cpuSw_dataManager_dataManager/include \
	-I$(TOP_DIR)/components/cpuSw_dataAnalysis_dataAnalysis/include \
	-I$(TOP_DIR)/components/cpuSw_decryptor_decryptor/include \
	-I$(TOP_DIR)/components/cpuSw_encryptor_encryptor/include \
	-I$(TOP_DIR)/components/cpuSw_logMonitor_logMonitor/include \
	-I$(TOP_DIR)/components/cpuSw_reportMonitor_reportMonitor/include \
	-I$(TOP_DIR)/components/cpuSw_firewall_firewall/include \
	-I$(TOP_DIR)/components/cpuSw_wifiDriver_wifiDriver_wifiDriver/include \
	-I$(TOP_DIR)/components/cpuSw_wifiDriver_wifiDriverVM_wifiDriver/include


UTIL_OBJS :=

TYPE_OBJS := \
	sb_queue_Common_DummyMessage_Impl_1.o \
	sb_queue_Common_ResponseLog_Impl_1.o \
	sb_queue_Common_Request_Impl_1.o \
	sb_queue_Common_AnalysisReport_Impl_1.o \
	sb_queue_Common_Log_Impl_1.o \
	sb_queue_uint8_t_1.o \
	sb_queue_Common_AnalysisRequest_Impl_1.o \
	sb_queue_Common_encryptedPayload_Impl_1.o \
	sb_queue_Common_IncomingWifiMessage_Impl_1.o \
	sb_queue_hamr_SchedState_1.o \
	sb_queue_hamr_Schedule_1.o


all: cache.o

# Sentinel file whose name encodes a hash of CFLAGS, BOARD, and MICROKIT_CONFIG.
# When any of those change the old sentinel is removed and a new one is created,
# which can be used as a prerequisite to force recompilation.
CHECK_FLAGS_BOARD_MD5:=.board_cflags-$(shell echo -- ${CFLAGS} ${BOARD} ${MICROKIT_CONFIG}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .board_cflags-*
	touch $@


vpath %.c $(SDDF) \
	$(TOP_DIR)/scheduler/src \
	$(TOP_DIR)/types/src \
	$(TOP_DIR)/components/cpuSw_btDriver_btDriver/src \
	$(TOP_DIR)/components/cpuSw_usbDriver_usbDriver/src \
