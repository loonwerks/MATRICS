--					)));
--			initialize
--				modifies zeroize_cmd;
--				
--				guarantee defaultZeroize:
--					zeroize_cmd == false;
--				
--			compute
--				modifies cache, zeroize_cmd;
--				
--				guarantee zeroize_cmd_variable "G: Once a zeroize command is seen, always zeroize.":
--					(HasEvent(zeroize) ->: zeroize_cmd == true) & (In(zeroize_cmd) == true ->: zeroize_cmd == true);
--
--				guarantee Zeroize_Payload "G: Zeroize outgoing responses once an alert is received and when a request has been made." :
--					(zeroize_cmd & HasEvent(request_log)) ->: IS_ZEROIZED(response_log.payload);
--				guarantee Zeroize_Cache "G: Zeroize cache once an alert is received." :
--					zeroize_cmd ->: IS_ZEROIZED(cache);	
--		**};
		
	end dataManager;
	
	thread dataAnalysis
		features
			request_log: out event data port Common::Request.Impl;
			response_log: in event data port Common::ResponseLog.Impl;
			analysis_report: out event data port Common::AnalysisReport.Impl;
			analysis_request: in event data port Common::AnalysisRequest.Impl;
		flows
			f1: flow path analysis_request -> request_log;
			f2: flow path response_log -> analysis_report;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
		annex agree {**
			assume Trusted_Request "A: Requests received are from a trusted source." :
				event(analysis_request) => FOUND_IN_ALLOW_LIST(ALLOW_LIST, analysis_request.header.client);
		**};
	end dataAnalysis;

	thread btDriver
		features
			btRecv: in event data port Common::DummyMessage.Impl;			
			btSend: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path btRecv -> btSend;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
	end btDriver;
	
	thread usbDriver
		features
			usbRecv: in event data port Common::DummyMessage.Impl;
			usbSend: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path usbRecv -> usbSend;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;
	end usbDriver;

	-- The Ground Station communication system
	system GroundStation
		features
			wifiRecv: in event data port Common::IncomingWifiMessage.Impl;
			wifiSend: out event data port Common::DummyMessage.Impl;
			btSend: out event data port Common::DummyMessage.Impl;
			btRecv: in event data port Common::DummyMessage.Impl;
			usbRecv: in event data port Common::DummyMessage.Impl;
			usbSend: out event data port Common::DummyMessage.Impl;
			wfa: requires bus access Common::WF_Bus;
			bta: requires bus access Common::BT_Bus;					
		flows
			f1: flow sink wifiRecv;
	end GroundStation;
	
	system implementation GroundStation.Impl
		subcomponents
			wifi: device Common::Wifi.Impl;
			bluetooth: device Common::Bluetooth.Impl;
			usb: device Common::USB.Impl;
			cpu: processor Proc.Impl;
			vcpu: virtual processor virt_proc;
			mem: memory Mem.Impl;
			storage: memory Storage.Impl;
			ser1: bus Common::Serial_Bus.Impl;
			ser2: bus Common::Serial_Bus.Impl;
			ser3: bus Common::Serial_Bus.Impl;
			ser4: bus Common::Serial_Bus.Impl;			
			cpuSw: system Hardened_SW::SW_seL4.hardened;
		connections
			-- Processor connected to memory and storage
			bac1: bus access mem.sera <-> ser1;
			bac2: bus access cpu.sera <-> ser1;
			bac3: bus access storage.sera <-> ser1;			
			-- Wi-Fi connected to CPU
			bac4: bus access wifi.sera <-> ser2;
			bac5: bus access cpu.sera <-> ser2;
			-- Bluetooth connected to CPU
			bac6: bus access bluetooth.sera <-> ser3;
			bac7: bus access cpu.sera <-> ser3;			
			-- USB connected to CPU
			bac8: bus access usb.sera <-> ser4;
			bac9: bus access cpu.sera <-> ser4;
			-- Wi-Fi connected to the outside			
			bac10: bus access wifi.wfa <-> wfa;
			-- Bluetooth connected to the outside			
			bac11: bus access bluetooth.bta <-> bta;
			--
			c1: port cpuSw.wifiSend -> wifi.sendIn;
			c2: port wifi.sendOut -> wifiSend;
			c3: port wifiRecv -> wifi.recvIn;
			c4: port wifi.recvOut -> cpuSw.wifiRecv;
			c5: port bluetooth.recvOut -> cpuSw.btRecv;
			c6: port cpuSW.btSend -> bluetooth.sendIn;
			c7: port bluetooth.sendOut -> btSend;
			c8: port btRecv -> bluetooth.recvIn; 
			c9: port usb.recvOut -> cpuSW.usbRecv;
			c10: port cpuSW.usbSend -> usb.sendIn;
			c11: port usbRecv -> usb.recvIn;
			c12: port usb.sendOut -> usbSend;	
		flows
			f1: flow sink wifiRecv -> c3 -> wifi.f1 -> c4 -> cpuSw.f1; 
		properties
			Actual_Processor_Binding => (reference (vcpu)) applies to cpuSw.wifiDriver.wifiDriverVM;
			Actual_Processor_Binding => (reference (cpu)) applies to cpuSw, vcpu;
			Actual_Connection_Binding => (reference (ser2)) applies to c1, c4;
			MATRICS_Properties::Memory_Type => RAM applies to mem;
			MATRICS_Properties::Memory_Type => ON_DISK applies to storage;			
			Actual_Memory_Binding => (reference (storage)) applies to cpuSW.dataManager.logs;			
			
			-- present in hardened system
			MATRICS_Properties::OS => "seL4" applies to cpu;
			HAMR::Platform => (Microkit);
			HAMR::Microkit_Language => Rust;
		annex resolute {**
			argue is_seL4_compliant(this.cpuSW)
			argue is_firewalled(this.cpuSW.dataAnalysis.dataAnalysis, this.cpuSW.c22, Common::AnalysisRequest.Impl)
			argue is_monitored_gated(this.cpuSW.dataManager.dataManager, this.cpuSW.dataAnalysis.dataAnalysis, Common::ResponseLog.Impl)		
			argue is_monitored_gated(this.cpuSW.encryptor.encryptor, this.cpuSW.wifiDriver.wifiDriver.wifiDriver, Common::AnalysisReport.Impl)
			argue is_message_encrypted(this.cpuSW.wifiDriver.wifiDriver, Common::AnalysisReport.Impl)
			argue uses_authorized_communication(this.cpuSw.dataManager.dataManager, this.cpuSW.wifiDriver.wifiDriverVM.wifiDriver)
			argue confidential_data_secure_storage(this.cpuSw, this.cpuSw.dataManager.dataManager)
		**};
	end GroundStation.Impl;
	
end GroundStation;
