package GroundStation
public
	with Common;
	with CASE_Scheduling;
	with HAMR;
	with AGREE_PLTL;
	renames AGREE_PLTL::all;	
	with MATRICS_Properties;
	with MATRICS_Model_Transformations;
	renames MATRICS_Model_Transformations::all;
	with Hardened_SW;
	with Base_Types;
	
	-- Processor for Ground Station communication system
	processor Proc
		features
			sera: requires bus access Common::Serial_Bus;
		properties
			Frame_Period => 1000ms;
			Clock_Period => 1ms;
			CASE_Scheduling::Max_Domain => 15;				
	end Proc;
	
	processor implementation Proc.Impl
	end Proc.Impl;
	
	-- Virtual Processor for Ground Station communication system
	virtual processor virt_proc
	end virt_proc;
	
	
	-- Memory and storage for Ground Station communication system
	memory Mem
		features
			sera: requires bus access Common::Serial_Bus;		
	end Mem;
	
	memory implementation Mem.Impl	
	end Mem.Impl;
	
	memory Storage
		features
			sera: requires bus access Common::Serial_Bus;		
	end Storage;
	
	memory implementation Storage.Impl	
	end Storage.Impl;
	
	
	thread wifiDriver
		features
			wifiRecv: in event data port Common::IncomingWifiMessage.Impl;
			wifiSend: out event data port Common::DummyMessage.Impl;
			HMD_log: out event data port Common::encryptedPayload.Impl;
			analysis_report: in event data port Common::AnalysisReport.Impl;
			analysis_request: out event data port Common::AnalysisRequest.Impl;
			alert: in event data port Common::DummyMessage.Impl;
		flows
			f1: flow path wifiRecv -> HMD_log;
			f2: flow path wifiRecv -> analysis_Request;
			f3: flow path analysis_report -> wifiSend;
			f4: flow sink alert;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;			
		annex agree {**
			assume Alert "A: A report should not be received if an alert is received." :
				event(alert) => not(event(analysis_report));
			assume Trusted_Report "A: Reports received are to a trusted destination." :
				event(analysis_report) => FOUND_IN_ALLOW_LIST(ALLOW_LIST, analysis_report.header.client);
			-- NOTE: Do we care about the structure of wifiSend (e.g. to ensure something like wifiSend = analysis_report)?
			guarantee Process_Report "G: Stop outgoing communication once an alert has been received." :
				if event(analysis_report) and not(Once(event(alert)))
				then event(wifiSend)
				else not(event(wifiSend));
		**};
		annex GUMBO{**
			state
				alert_cmd: Base_Types::Boolean;
			initialize
				modifies alert_cmd;
				
				guarantee defaultAlert:
					alert_cmd == false;
				
			compute
				modifies alert_cmd;
			
				guarantee alert_cmd_variable "G: Once an alert command is seen, always stay alerted.":
					(HasEvent(alert) ->: alert_cmd == true) & (In(alert_cmd) == true ->: alert_cmd == true);
				
				guarantee Process_Report "G: Stop outgoing communication once an alert has been received." :
					if (HasEvent(analysis_report) & !(alert_cmd)) 
                         MustSend(wifiSend) 
                         else NoSend(wifiSend);
		**};
	end wifiDriver;
	
	thread dataManager
		features
			HMD_log: in event data port Common::Log.Impl;
			request_log: in event data port Common::Request.Impl;
			response_log: out event data port Common::ResponseLog.Impl;
			zeroize: in event port;
			log_data: requires data access Common::LogArray {Access_Right => read_write;};
		flows
			f1: flow sink HMD_log;
			f2: flow path request_log -> response_log;
			f3: flow sink zeroize;
		properties
			Dispatch_Protocol => Periodic;
			Period => 1000ms;
			Stack_size => 1048576 Bytes;		
		annex agree {**
			eq cache: Common::LogArray.Impl;			
				
			fun IS_ZEROIZED(logs: Common::LogArray.Impl): bool = 
				forall i in indices(logs), logs[i] = NULL_LOG;
				
			guarantee Zeroize_Payload "G: Zeroize outgoing responses once an alert is received and when a request has been made." :
				Once(event(zeroize)) and event(request_log) => IS_ZEROIZED(response_log.payload);
			guarantee Zeroize_Cache "G: Zeroize cache once an alert is received." :
				Once(event(zeroize)) => IS_ZEROIZED(cache);
		**};
