package Common
public
	with Data_Model;
	with Base_Types;
	with HAMR;

	-- Wi-Fi: range 150ft, higher data transfer and power consumption than Bluetooth
	bus WF_Bus
	end WF_Bus;

	bus implementation WF_Bus.Impl
	end WF_Bus.Impl;
	
	-- Bluetooth: range 150ft, lower data transfer and power consumption than Bluetooth
	bus BT_Bus
	end BT_Bus;

	bus implementation BT_Bus.Impl
	end BT_Bus.Impl;

	bus Serial_Bus
	end Serial_Bus;

	bus implementation Serial_Bus.Impl
	end Serial_Bus.Impl;
	
	
	-- Wi-Fi hardware
	device Wifi
		features
			sera: requires bus access Serial_Bus;
			wfa: requires bus access WF_Bus;
			recvIn: in event data port Common::IncomingWifiMessage.Impl;
			recvOut: out event data port Common::IncomingWifiMessage.Impl;
			sendIn: in event data port Common::DummyMessage.Impl;
			sendOut: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path recvIn -> recvOut;
			f2: flow path sendIn -> sendOut;
	end Wifi;
	
	device implementation Wifi.Impl	
	end Wifi.Impl;
	
	-- Bluetooth hardware
	device Bluetooth
		features
			sera: requires bus access Serial_Bus;
			bta: requires bus access BT_Bus;
			recvIn: in event data port Common::DummyMessage.Impl;
			recvOut: out event data port Common::DummyMessage.Impl;
			sendIn: in event data port Common::DummyMessage.Impl;
			sendOut: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path recvIn -> recvOut;
			f2: flow path sendIn -> sendOut;
	end Bluetooth;
	
	device implementation Bluetooth.Impl	
	end Bluetooth.Impl;
	
	-- USB hardware
	device USB
		features
			sera: requires bus access Serial_Bus;
			recvIn: in event data port Common::DummyMessage.Impl;
			recvOut: out event data port Common::DummyMessage.Impl;
			sendIn: in event data port Common::DummyMessage.Impl;
			sendOut: out event data port Common::DummyMessage.Impl;
		flows
			f1: flow path recvIn -> recvOut;
			f2: flow path sendIn -> sendOut;
	end USB;
	
	device implementation USB.Impl
	end USB.Impl;
	
	-- Custom SW handling Wi-Fi and Bluetooth communication, interacting with other SW via IPC
	process Com_SW
		features
			ipcDataIn: in data port;
			ipcDataOut: out data port;
			wfComIn: in data port;
			wfComOut: out data port;
			btComIn: in data port;
			btComOut: out data port;
		flows
			f1: flow path wfComIn -> ipcDataOut;
			f2: flow path ipcDataIn -> wfComOut;
			f3: flow path btComIn -> ipcDataOut;
			f4: flow path ipcDataIn -> btComOut;
	end Com_SW;
	
	process implementation Com_SW.Impl
	end Com_SW.Impl;
	
	
	-- To represent communication between native and custom software
	virtual bus IPC_Com
	end IPC_Com;
	
	virtual bus implementation IPC_Com.Impl
	end IPC_Com.Impl;
	
	-- To represent TCP protocol
	virtual bus TCP
	end TCP;
	
	virtual bus implementation TCP.Impl
	end TCP.Impl;
	
	
	-- Message structures used by ground station
	-- Message header
	data MsgHeader
	end MsgHeader;

	data implementation MsgHeader.Impl
		subcomponents
			client: data Base_Types::Unsigned_32;
	end MsgHeader.Impl;
	
	-- HMD log message structure
	data Log
	end Log;
	
	-- NOTE: need to define sizes for these data elements
	data implementation Log.Impl
		subcomponents
			timestamp: data Base_Types::Unsigned_32;
			userID: data Base_Types::Unsigned_32;
			numSuspects: data Base_Types::Unsigned_32;
			numSuspectsFlagged: data Base_Types::Unsigned_32;
			yaw: data Base_Types::Integer_32;
			pitch: data Base_Types::Integer_32;
			roll: data Base_Types::Integer_32;
	end Log.Impl;

	-- Analysis request message structure
	data AnalysisRequest
	end AnalysisRequest;
	
	data Request
	end Request;
	
	data implementation Request.Impl
		subcomponents
			requestID: data Base_Types::Integer_32;
			analysisType: data Base_Types::Integer_32;
			userID: data Base_Types::Integer_32;
			startTime: data Base_Types::Integer_32;
			endTime: data Base_Types::Integer_32;
	end Request.Impl;
	
	data implementation AnalysisRequest.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data Request.Impl;
	end AnalysisRequest.Impl;
	
	-- Response log message structure
	data ResponseLog
	end ResponseLog;
	
	data ResponseHeader
	end ResponseHeader;
	
	data implementation ResponseHeader.Impl
		subcomponents
			requestID: data Base_Types::Integer_32;
			sequenceNumber: data Base_Types::Integer_32;
			totalParts: data Base_Types::Integer_32;
	end ResponseHeader.Impl;
	
	data LogArray
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Log.Impl));
			Data_Model::Dimension => (100);
			Memory_Properties::Data_Size => 100 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end LogArray;
	
	data implementation LogArray.Impl
	end LogArray.Impl;

	data implementation ResponseLog.Impl
		subcomponents
			header: data ResponseHeader.Impl;
			payload: data LogArray.Impl;
	end ResponseLog.Impl;
	
	-- Analysis report message structure
	data AnalysisReport
	end AnalysisReport;
	
	data implementation AnalysisReport.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data OutgoingPayload.Impl;
	end AnalysisReport.Impl;
	
	data DummyMessage
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (100);
			Memory_Properties::Data_Size => 100 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end DummyMessage;
	
	data implementation DummyMessage.Impl
	end DummyMessage.Impl;
	
	data encryptedIncomingPayload
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (1024);
			Memory_Properties::Data_Size => 1024 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end encryptedIncomingPayload;
	
	data implementation encryptedIncomingPayload.Impl
	end encryptedIncomingPayload.Impl;
	
	data OutgoingPayload
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Unsigned_8));
			Data_Model::Dimension => (32768);
			Memory_Properties::Data_Size => 32768 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end OutgoingPayload;
	
	data implementation OutgoingPayload.Impl
	end OutgoingPayload.Impl;
	
	data shortText
		properties
			Data_Model::Data_Representation => Array;
			Data_Model::Base_Type => (classifier (Base_Types::Character));
			Data_Model::Dimension => (64);
			Memory_Properties::Data_Size => 64 Bytes;
			HAMR::Array_Size_Kind => Fixed;
	end shortText;
	
	data implementation shortText.Impl
	end shortText.Impl;
	
		
	data IncomingWifiHeader
	end IncomingWifiHeader;

	data implementation IncomingWifiHeader.Impl
		subcomponents
			route: data shortText;
			client: data Base_Types::Unsigned_32;
	end IncomingWifiHeader.Impl;
	
	data IncomingWifiMessage
	end IncomingWifiMessage;
	
	data implementation IncomingWifiMessage.Impl
		subcomponents
			header: data IncomingWifiHeader.Impl;
			payload: data encryptedIncomingPayload.Impl;
	end IncomingWifiMessage.Impl;
		
end Common;
