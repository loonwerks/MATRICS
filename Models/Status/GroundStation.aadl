package GroundStation
public
	with Common;
	with MATRICS_Properties;	
	
	-- Processor for Ground Station communication system
	processor Proc
		features
			sera: requires bus access Common::Serial_Bus;			
	end Proc;
	
	processor implementation Proc.Impl
	end Proc.Impl;
	
	
	-- Memory and storage for Ground Station communication system
	memory Mem
		features
			sera: requires bus access Common::Serial_Bus;		
	end Mem;
	
	memory implementation Mem.Impl	
	end Mem.Impl;
	
	memory Storage
		features
			sera: requires bus access Common::Serial_Bus;		
	end Storage;
	
	memory implementation Storage.Impl	
	end Storage.Impl;
	
	
	thread wifiDriver
		features
			wifiRecv: in event data port;
			wifiSend: out event data port;
			HMD_log: out event data port;
			analysis_report: in event data port;
			analysis_request: out event data port;
			alert: in event data port;
		flows
			f1: flow path wifiRecv -> HMD_log;
			f2: flow path wifiRecv -> analysis_Request;
			f3: flow path analysis_report -> wifiSend;
	end wifiDriver;
	
	thread dataManager
		features
			HMD_log: in event data port;
			request_log: in event data port;
			response_log: out event data port;
			zeroize: in event port;
		flows
			f1: flow sink HMD_log;
			f2: flow path request_log -> response_log;
	end dataManager;
	
	thread dataAnalysis
		features
			request_log: out event data port;
			response_log: in event data port;
			analysis_report: out event data port;
			analysis_request: in event data port;
		flows
			f1: flow path analysis_request -> request_log;
			f2: flow path response_log -> analysis_report;
	end dataAnalysis;

	thread btDriver
		features
			btRecv: in event data port;			
			btSend: out event data port;
		flows
			f1: flow path btRecv -> btSend;
	end btDriver;
	
	thread usbDriver
		features
			usbRecv: in event data port;
			usbSend: out event data port;
		flows
			f1: flow path usbRecv -> usbSend;
	end usbDriver;
	
	process SW
		features
			wifiRecv: in event data port;
			wifiSend: out event data port;
			--
			btRecv: in event data port;			
			btSend: out event data port;
			--
			usbRecv: in event data port;			
			usbSend: out event data port;
		flows
			f1: flow sink wifiRecv;
			f2: flow path btRecv -> btSend;
			f3: flow path usbRecv -> usbSend;
	end SW;
	
	process implementation SW.unhardened
		subcomponents
			wifiDriver: thread wifiDriver;
			btDriver: thread btDriver;
			usbDriver: thread usbDriver;
			dataManager: thread dataManager;
			dataAnalysis: thread dataAnalysis;
		connections
			-- Wi-Fi exchange with outside
			c1: port wifiRecv -> wifiDriver.wifiRecv;
			c2: port wifiDriver.wifiSend -> wifiSend;
			-- Bluetooth exchange with outside
			c9: port btRecv -> btDriver.btRecv;
			c10: port btDriver.btSend -> btSend;
			-- USB exchange with outside
			c11: port usbRecv -> usbDriver.usbRecv;
			c12: port usbDriver.usbSend -> usbSend;
			-- internal data communication
			c3: port wifiDriver.HMD_log -> dataManager.HMD_log;
			c4: port dataAnalysis.request_log -> dataManager.request_log;
			c5: port dataManager.response_log -> dataAnalysis.response_log;
			c6: port dataAnalysis.analysis_report -> wifiDriver.analysis_report;
			c7: port wifiDriver.analysis_request -> dataAnalysis.analysis_request;
		flows
			-- analysis request flow path
			f1: flow sink wifiRecv -> c1 -> wifiDriver.f1 -> c3 -> dataManager.f1;
	end SW.unhardened;
	

	-- The Ground Station communication system
	system GroundStation
		features
			wifiRecv: in event data port;
			wifiSend: out event data port;
			btSend: out event data port;
			btRecv: in event data port;
			wfa: requires bus access Common::WF_Bus;
			bta: requires bus access Common::BT_Bus;
		flows
			f1: flow sink wifiRecv;
	end GroundStation;
	
	system implementation GroundStation.Impl
		subcomponents
			wifi: device Common::Wifi.Impl;
			bluetooth: device Common::Bluetooth.Impl;
			usb: device Common::USB.Impl;
			cpu: processor Proc.Impl;
			mem: memory Mem.Impl;
			storage: memory Storage.Impl;
			ser1: bus Common::Serial_Bus.Impl;
			ser2: bus Common::Serial_Bus.Impl;
			ser3: bus Common::Serial_Bus.Impl;
			ser4: bus Common::Serial_Bus.Impl;			
			cpuSw: process SW.unhardened;
		connections
			-- Processor connected to memory and storage
			bac1: bus access mem.sera <-> ser1;
			bac2: bus access cpu.sera <-> ser1;
			bac3: bus access storage.sera <-> ser1;			
			-- Wi-Fi connected to CPU
			bac4: bus access wifi.sera <-> ser2;
			bac5: bus access cpu.sera <-> ser2;
			-- Bluetooth connected to CPU
			bac6: bus access bluetooth.sera <-> ser3;
			bac7: bus access cpu.sera <-> ser3;			
			-- USB connected to CPU
			bac8: bus access usb.sera <-> ser4;
			bac9: bus access cpu.sera <-> ser4;
			-- Wi-Fi connected to the outside			
			bac10: bus access wifi.wfa <-> wfa;
			-- Bluetooth connected to the outside			
			bac11: bus access bluetooth.bta <-> bta;
			--
			c1: port cpuSw.wifiSend -> wifi.sendIn;
			c2: port wifi.sendOut -> wifiSend;
			c3: port wifiRecv -> wifi.recvIn;
			c4: port wifi.recvOut -> cpuSw.wifiRecv;
			c5: port bluetooth.recvOut -> cpuSw.btRecv;
			c6: port cpuSW.btSend -> bluetooth.sendIn;
			c7: port bluetooth.sendOut -> btSend;
			c8: port btRecv -> bluetooth.recvIn; 
			c9: port usb.usbSend -> cpuSW.usbRecv;
			c10: port cpuSW.usbSend -> usb.usbRecv;
		flows
			f1: flow sink wifiRecv -> c3 -> wifi.f1 -> c4 -> cpuSw.f1; 
		properties
			Actual_Processor_Binding => (reference (cpu)) applies to cpuSw;
			Actual_Connection_Binding => (reference (ser2)) applies to c1, c4;
			
			-- present in hardened system
			--MATRICS_Properties::OS => "seL4" applies to cpu;
	end GroundStation.Impl;
	
end GroundStation;
