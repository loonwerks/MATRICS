-- One ground station connected with one HMD
package Status_Scenario_1
public
	with GroundStation;
	with HMD;
	with Common;

	system HMD_GS
		-- NOTE: to determine information flows
	end HMD_GS;

	system implementation HMD_GS.Impl
		subcomponents
			groundStation: system GroundStation::GroundStation.Impl;
			hmd: system HMD::HMD.Impl;
			wf: bus Common::WF_Bus.Impl;
		connections
			p1: port GroundStation.WifiSend -> hmd.wifiRecv;
			p2: port hmd.wifiSend -> GroundStation.wifiRecv;
			bac1: bus access wf <-> GroundStation.wfa;
			bac2: bus access wf <-> hmd.wfa;
		properties
			Actual_Connection_Binding => (reference (wf)) applies to p1, p2;
	end HMD_GS.Impl;

end Status_Scenario_1;
