package Hardened_SW
public
	with GroundStation;
	renames Groundstation::all;
	with AGREE_PLTL;
	renames AGREE_PLTL::all;
	with MATRICS_Properties;
	with Base_Types;
	
	-- Processes introduced to isolate threads
	process wifiDriver_seL4
		features
			wifiRecv: in event data port;
			wifiSend: out event data port;
			HMD_log: out event data port;
			analysis_report: in event data port;
			analysis_request: out event data port;
			alert: in event data port;
		flows
			f1: flow path wifiRecv -> HMD_log;
			f2: flow path wifiRecv -> analysis_Request;
			f3: flow path analysis_report -> wifiSend;			
	end wifiDriver_seL4;
	
	process implementation wifiDriver_seL4.Impl
		subcomponents
			wifiDriver: thread wifiDriver;
		connections
			c1: port wifiRecv -> wifiDriver.wifiRecv;
			c2: port analysis_report -> wifiDriver.analysis_report;
			c3: port wifiDriver.wifiSend -> wifiSend;
			c4: port wifiDriver.HMD_log -> HMD_log;
			c5: port wifiDriver.analysis_request -> analysis_request;
			c6: port alert -> wifiDriver.alert;
	end wifiDriver_seL4.Impl;
	
	process dataManager_seL4
		features
			HMD_log: in event data port;
			request_log: in event data port;
			response_log: out event data port;
			zeroize: in event port;
		flows
			f1: flow sink HMD_log;
			f2: flow path request_log -> response_log;
	end dataManager_seL4;
	
	process implementation dataManager_seL4.Impl
		subcomponents
			dataManager: thread dataManager;
		connections
			c1: port HMD_log -> dataManager.HMD_log;
			c2: port request_log -> dataManager.request_log;
			c3: port dataManager.response_log -> response_log;
			c4: port zeroize -> dataManager.zeroize;
	end dataManager_seL4.Impl;
	
	process dataAnalysis_seL4
		features
			request_log: out event data port;
			response_log: in event data port;
			analysis_report: out event data port;
			analysis_request: in event data port;
		flows
			f1: flow path analysis_request -> request_log;
			f2: flow path response_log -> analysis_report;
	end dataAnalysis_seL4;
	
	process implementation dataAnalysis_seL4.Impl
		subcomponents
			dataAnalysis: thread dataAnalysis;
		connections
			c1: port response_log -> dataAnalysis.response_log;
			c2: port analysis_request -> dataAnalysis.analysis_Request;
			c3: port dataAnalysis.request_log -> request_log;
			c4: port dataAnalysis.analysis_report -> analysis_report;
	end dataAnalysis_seL4.Impl;

	process btDriver_seL4
		features
			btRecv: in event data port;			
			btSend: out event data port;
		flows
			f1: flow path btRecv -> btSend;
	end btDriver_seL4;
	
	process implementation btDriver_seL4.Impl
		subcomponents
			btDriver: thread btDriver;
		connections
			c1: port btRecv -> btDriver.btRecv;
			c2: port btDriver.btSend -> btSend;
	end btDriver_seL4.Impl;
	
	process usbDriver_seL4
		features
			usbRecv: in event data port;
			usbSend: out event data port;
		flows
			f1: flow path usbRecv -> usbSend;
	end usbDriver_seL4;
	
	process implementation usbDriver_seL4.Impl
		subcomponents
			usbDriver: thread usbDriver;
		connections
			c1: port usbRecv -> usbDriver.usbRecv;
			c2: port usbDriver.usbSend -> usbSend;
	end usbDriver_seL4.Impl;
	
	-- High-Assurance Components
	-- monitors the behavior of the dataManager component

	-- Message header
	data MsgHeader
	end MsgHeader;

	data implementation MsgHeader.Impl
		subcomponents
			src: data Base_Types::Unsigned_32;
			dst: data Base_Types::Unsigned_32;
	end MsgHeader.Impl;

	-- RF Message structure
	data Response_Log
	end Response_Log;

	data implementation Response_Log.Impl
		subcomponents
			header: data MsgHeader.Impl;
			payload: data;
	end Response_Log.Impl;
	
	thread monitor1
		features
			request_log: in event data port;
			response_log_in: in event data port Response_Log.Impl;
			response_log_out: out event data port Response_Log.Impl;			
			alert: out event port;
		annex agree {**
			eq temp: bool = response_log_out = response_log_in;
			eq is_valid: bool = 
				if event(request_log) and event(response_log_in)
				then true
				else event(response_log_in) => Yesterday(Since(not(event(response_log_in)), event(request_log)));

			guarantee Alert "G: Send an alert if more than one response is received without a request." :
				if event(response_log_in) and not(is_valid)
				then event(alert)
				else not(event(alert));
			guarantee Forward_Response "G: Only forward a response if a request has been made." :
				if event(response_log_in) and is_valid
				then event(response_log_out) and (response_log_out = response_log_in)
				else not(event(response_log_out));
		**};
	end monitor1;
	
	process monitor1_seL4
		features
			request_log: in event data port;
			response_log_in: in event data port;
			response_log_out: out event data port;
			alert: out event port;
		properties
			MATRICS_Properties::Component_Type => MONITOR;
	end monitor1_seL4;
	
	process implementation monitor1_seL4.Impl
		subcomponents
			monitor1: thread monitor1;
		connections
			c1: port request_log -> monitor1.request_log;
			c2: port response_log_in -> monitor1.response_log_in;
			c3: port monitor1.response_log_out -> response_log_out;
			c4: port monitor1.alert -> alert;
		annex agree {**
			lift contract;
		**};
	end monitor1_seL4.Impl;

	-- monitors the behavior of the dataAnalysis component and incoming requests
	thread monitor2
		features
			analysis_request: in event data port;
			analysis_report: in event data port;
			alert: out event data port;
		annex agree {**
			node Counter(i: bool, reset: bool) returns (count: int);
			let
				count = if reset then 0 
							else 0 -> if i then pre(count) + 1 
								else pre(count);
			tel;
			
			const threshold: int = 3;			
			eq is_valid1: bool = 
				if event(analysis_request) and event(analysis_report)
				then true
				else event(analysis_report) => Yesterday(Since(not(event(analysis_report)), event(analysis_request)));
			eq is_invalid2: bool = Counter(event(analysis_request), event(analysis_report)) >= threshold;
								 
			guarantee Alert1 "G: Send an alert if more than one report is received without a request." :
				if event(analysis_report) and not(is_valid1)
				then event(alert)
				else not(event(alert));
			guarantee Alert2 "G: Send an alert if 3 or more requests are received without a report." :
				if is_invalid2
				then event(alert)
				else not(event(alert));
		**};
	end monitor2;

	process monitor2_seL4
		features
			analysis_request: in event data port;
			analysis_report: in event data port;
			alert: out event data port;
		properties
			MATRICS_Properties::Component_Type => MONITOR;
	end monitor2_seL4;
	
	process implementation monitor2_seL4.Impl
		subcomponents
			monitor2: thread monitor2;
		connections
			c1: port analysis_request -> monitor2.analysis_request;
			c2: port analysis_report -> monitor2.analysis_report;
			c3: port monitor2.alert -> alert;
		annex agree {**
			lift contract;
		**};
	end monitor2_seL4.Impl;
	
	-- handles decryption
	thread decryptor
		features
			HMD_log_in: in event data port;
			HMD_log_out: out event data port;
		flows
			f1: flow path HMD_log_in -> HMD_log_out;
	end decryptor;

	process decryptor_seL4
		features
			HMD_log_in: in event data port;
			HMD_log_out: out event data port;
		flows
			f1: flow path HMD_log_in -> HMD_log_out;
		properties
			MATRICS_Properties::Component_Type => DECRYPTOR;
	end decryptor_seL4;
	
	process implementation decryptor_seL4.Impl
		subcomponents
			decryptor: thread decryptor;
		connections
			c1: port HMD_log_in -> decryptor.HMD_log_in;
			c2: port decryptor.HMD_log_out -> HMD_log_out;
	end decryptor_seL4.Impl;
	
	-- handles encryption
	thread encryptor
		features
			analysis_report_in: in event data port;
			analysis_report_out: out event data port;
		flows
			f1: flow path analysis_report_in -> analysis_report_out;		
	end encryptor;
	
	process encryptor_seL4
		features
			analysis_report_in: in event data port;
			analysis_report_out: out event data port;
		flows
			f1: flow path analysis_report_in -> analysis_report_out;
		properties
			MATRICS_Properties::Component_Type => ENCRYPTOR;
	end encryptor_seL4;
	
	process implementation encryptor_seL4.Impl
		subcomponents
			encryptor: thread encryptor;
		connections
			c1: port analysis_report_in -> encryptor.analysis_report_in;
			c2: port encryptor.analysis_report_out -> analysis_report_out;
	end encryptor_seL4.Impl;
	
	-- filters the analysis request to guarantee it is from a trusted device
	thread filter
		features
			analysis_request_in: in event data port;
			analysis_request_out: out event data port;
		flows
			f1: flow path analysis_request_in -> analysis_request_out;
	end filter;
	
	process filter_seL4
		features
			analysis_request_in: in event data port;
			analysis_request_out: out event data port;
		flows
			f1: flow path analysis_request_in -> analysis_request_out;
		properties
			MATRICS_Properties::Component_Type => FILTER;
	end filter_seL4;
	
	process implementation filter_seL4.impl
		subcomponents
			filter: thread filter;
		connections
			c1: port analysis_request_in -> filter.analysis_request_in;
			c2: port filter.analysis_request_out -> analysis_request_out;
	end filter_seL4.impl;
	
	-- Hardened Software System
	system SW_seL4
		features
			wifiRecv: in event data port;
			wifiSend: out event data port;
			--
			btRecv: in event data port;			
			btSend: out event data port;
			--
			usbRecv: in event data port;			
			usbSend: out event data port;
	end SW_seL4;
	
	system implementation SW_seL4.hardened
		subcomponents
			wifiDriver: process wifiDriver_seL4.Impl;
			btDriver: process btDriver_seL4.Impl;
			usbDriver: process usbDriver_seL4.Impl;
			dataManager: process dataManager_seL4.Impl;
			dataAnalysis: process dataAnalysis_seL4.Impl;
			decryptor: process decryptor_seL4.Impl;
			encryptor: process encryptor_seL4.Impl;
			monitor1: process monitor1_seL4.Impl;
			monitor2: process monitor2_seL4.Impl;
			filter: process filter_seL4.Impl;
		connections
			-- Wi-Fi exchange with outside
			c1: port wifiRecv -> wifiDriver.wifiRecv;
			c2: port wifiDriver.wifiSend -> wifiSend;
			-- Bluetooth exchange with outside
			c9: port btRecv -> btDriver.btRecv;
			c10: port btDriver.btSend -> btSend;
			-- USB exchange with outside
			c11: port usbRecv -> usbDriver.usbRecv;
			c12: port usbDriver.usbSend -> usbSend;
			-- internal data communication
			c4: port dataAnalysis.request_log -> dataManager.request_log;
			-- decryption connections
			c19: port wifiDriver.HMD_log -> decryptor.HMD_log_in;
			c21: port decryptor.HMD_log_out -> dataManager.HMD_log;
			-- encryption connections
			c24: port dataAnalysis.analysis_report -> encryptor.analysis_report_in;
			c25: port encryptor.analysis_report_out -> wifiDriver.analysis_report;			
			-- monitor connections
			c13: port dataAnalysis.request_log -> monitor1.request_log;
			c14: port dataManager.response_log -> monitor1.response_log_in;
			c5: port monitor1.response_log_out -> dataAnalysis.response_log;
			c17: port monitor1.alert -> dataManager.zeroize;
			c15: port wifiDriver.analysis_request -> monitor2. analysis_request;
			c16: port encryptor.analysis_report_out -> monitor2. analysis_report;
			c18: port monitor2.alert -> wifiDriver.alert;
			--filter connections
			c22: port wifiDriver.analysis_request -> filter.analysis_request_in;
			c23: port filter.analysis_request_out -> dataAnalysis.analysis_request;
	end SW_seL4.hardened;
	
end Hardened_SW;
