-- Head-Worn Computer
package HMD_Computer
public
	with Common;
	
	-- Inertial Measurement Unit
	-- accelerometer, gyroscope, magnetometer
	device IMU
		features
			info: out data port;
			sera: requires bus access Common::Serial_Bus;
		flows
			f1: flow source info;
	end IMU;
	
	device implementation IMU.Impl
	end IMU.Impl;
	
	
	-- Main processing unit
	processor CPU
		features
			sera: requires bus access Common::Serial_Bus;
	end CPU;
	
	processor implementation CPU.Impl
	end CPU.Impl;
	
	
	-- Graphics Processing Unit
	processor GPU
		features
			sera: requires bus access Common::Serial_Bus;
	end GPU;
	
	processor implementation GPU.Impl
	end GPU.Impl;
	
	
	-- RAM
	memory CPU_Mem
		features
			sera: requires bus access Common::Serial_Bus;		
	end CPU_Mem;
	
	memory implementation CPU_Mem.Impl
	end CPU_Mem.Impl;
	
	memory GPU_Mem
		features
			sera: requires bus access Common::Serial_Bus;		
	end GPU_Mem;
	
	memory implementation GPU_Mem.Impl
	end GPU_Mem.Impl;
	
	
	-- Flash storage
	memory Storage		
		features
			sera: requires bus access Common::Serial_Bus;
	end Storage;
	
	memory implementation Storage.Impl
	end Storage.Impl;
	

	-- Software
	process Native_SW
		features
			ipcDataIn: in data port;
			ipcDataOut: out data port;
			--
			imuInfo: in data port;
			imageryIn: in data port;
			imageryOut: out data port;
			--
			eyeTrackInfo: in data port;
			depthInfo: in data port;
			cameraImagery: in data port;
		flows
			f1: flow path imageryIn -> imageryOut;
			f5: flow path eyeTrackInfo -> imageryOut;
			f6: flow path depthInfo -> imageryOut;
			f7: flow path cameraImagery -> imageryOut;
			f9: flow path imuInfo -> imageryOut;
			f10: flow path ipcDataIn -> ipcDataOut;
			f11: flow path eyeTrackInfo -> ipcDataOut;
			f12: flow path imuInfo -> ipcDataOut;
	end Native_SW;
	
	process implementation Native_SW.Impl
	end Native_SW.Impl;
	
	
	system CPU_SW
		features
			wfComIn: in data port;
			wfComOut: out data port;
			--
			btComIn: in data port;
			btComOut: out data port;
			--
			imuInfo: in data port;
			imageryIn: in data port;
			imageryOut: out data port;
			--
			eyeTrackInfo: in data port;
			depthInfo: in data port;
			cameraImagery: in data port;
		flows
			f1: flow path wfComIn -> wfComOut;
			f3: flow path btComIn -> btComOut;
			f2: flow path imageryIn -> imageryOut;
			f6: flow path eyeTrackInfo -> imageryOut;
			f7: flow path depthInfo -> imageryOut;
			f8: flow path cameraImagery -> imageryOut;
			f10: flow path imuInfo -> imageryOut;
			f11: flow path eyeTrackInfo -> wfComOut;
			f12: flow path imuInfo -> wfComOut;
	end CPU_SW;
	
	system implementation CPU_SW.Impl
		subcomponents
			nativeSw: process Native_SW.Impl;
			comSw: process Common::Com_SW.Impl;
			ipcCom: virtual bus Common::IPC_Com.Impl;
		connections
			c1: port nativeSw.ipcDataOut -> comSw.ipcDataIn;
			c2: port comSw.ipcDataOut -> nativeSw.ipcDataIn;
			--
			c5: port wfComIn -> comSw.wfComIn;
			c6: port comSw.wfComOut -> wfComOut;
			--
			c18: port btComIn -> comSw.btComIn;
			c19: port comSw.btComOut -> btComOut;
			--
			c8: port imuInfo -> nativeSw.imuInfo;
			c9: port imageryIn -> nativeSw.imageryIn;
			c10: port nativeSw.imageryOut -> imageryOut;
			c14: port eyeTrackInfo -> nativeSw.eyeTrackInfo;
			c15: port depthInfo -> nativeSw.depthInfo;
			c16: port cameraImagery -> nativeSw.cameraImagery;
		flows
			f11: flow path eyeTrackInfo -> c14 -> nativeSw.f11 -> c1 -> comSw.f2 -> c6 -> wfComOut;
			f12: flow path imuInfo -> c8 -> nativeSw.f12 -> c1 -> comSw.f2 -> c6 -> wfComOut;
		properties
			Actual_Connection_Binding => (reference (ipcCom)) applies to c1, c2;
	end CPU_SW.Impl;
	
	
	system GPU_SW
		features
			imageryIn: in data port;
			imageryOut: out data port;
			displayImagery: out data port;
		flows
			f1: flow path imageryIn -> imageryOut;
			f2: flow path imageryIn -> displayImagery;
	end GPU_SW;
	
	system implementation GPU_SW.Impl
	end GPU_SW.Impl;
	
	
	system Computer
		features
			sera: requires bus access Common::Serial_Bus;
			wfa: requires bus access Common::WF_Bus;
			bta: requires bus access Common::BT_Bus;
			eyeTrackInfo: in data port;
			depthInfo: in data port;
			cameraImagery: in data port;
			displayImagery: out data port; 
			wifiSend: out event data port;
			wifiRecv: in event data port;
			btSend: out event data port;
			btRecv: in event data port;
		flows
			f1: flow path eyeTrackInfo -> wifiSend;
			f2: flow source wifiSend;
	end Computer;
	
	system implementation Computer.Impl
		subcomponents
			cpu: processor CPU.Impl;
			gpu: processor GPU.Impl;
			cpuMem: memory CPU_Mem.Impl;
			gpuMem: memory GPU_Mem.Impl;
			storage: memory Storage.Impl;
			cpuSw: system CPU_SW.Impl;
			gpuSw: system GPU_SW.Impl;
			wifi: device Common::Wifi.Impl;
			bluetooth: device Common::Bluetooth.Impl;
			imu: device IMU.Impl;
			--
			ser1: bus Common::Serial_Bus.Impl;
			ser2: bus Common::Serial_Bus.Impl;
			ser3: bus Common::Serial_Bus.Impl;
			ser5: bus Common::Serial_Bus.Impl;
			ser6: bus Common::Serial_Bus.Impl;
			ser7: bus Common::Serial_Bus.Impl;
		connections
			-- Processor connected to memory and storage
			bac1: bus access cpu.sera <-> ser1;
			bac2: bus access cpuMem.sera <-> ser1;
			bac3: bus access storage.sera <-> ser1;
			-- GPU connected to CPU and memory
			bac4: bus access cpu.sera <-> ser2;
			bac5: bus access gpu.sera <-> ser2;
			c5: port cpuSW.imageryOut -> gpuSw.imageryIn;
			c6: port gpuSw.imageryOut -> cpuSW.imageryIn;
			bac17: bus access gpu.sera <-> ser7;
			bac18: bus access gpuMem.sera <-> ser7;
			-- Wi-Fi connected to CPU
			bac6: bus access cpu.sera <-> ser3;
			bac7: bus access wifi.sera <-> ser3;
			c3: port wifi.recvOut -> cpuSw.wfcomIn;
			c4: port cpuSW.wfcomOut -> wifi.sendIn;
			-- Bluetooth connected to CPU
			bac14: bus access cpu.sera <-> ser6;
			bac15: bus access bluetooth.sera <-> ser6;
			c16: port bluetooth.recvOut -> cpuSw.btComIn;
			c17: port cpuSW.btComOut -> bluetooth.sendIn;
			-- Position/facing unit connected to CPU
			bac10: bus access cpu.sera <-> ser5;
			bac11: bus access imu.sera <-> ser5;
			c2: port imu.info -> cpuSw.imuInfo;
			-- GPU connected to the outside
			bac12: bus access gpu.sera <-> sera;
			-- Wi-Fi connected to the outside
			bac13: bus access wifi.wfa <-> wfa;
			-- Bluetooth connected to the outside
			bac16: bus access bluetooth.bta <-> bta;
			-- CPU process data from HUD
			c7: port cameraImagery -> cpuSW.cameraImagery;
			c11: port eyeTrackInfo -> cpuSW.eyeTrackInfo;
			c12: port depthInfo -> cpuSW.depthInfo;
			-- GPU process data to HUD
			c13: port gpuSw.displayImagery -> displayImagery;
			-- Wi-Fi exchange with outside
			c14: port wifi.sendOut -> wifiSend;
			c15: port wifiRecv -> wifi.recvIn; 	
			-- Bluetooth exchange with outside
			c18: port bluetooth.sendOut -> btSend;
			c19: port btRecv -> bluetooth.recvIn; 
			-- NOTE: to determine information flows	
		flows
			f1: flow path eyeTrackInfo -> c11 -> cpuSW.f11 -> c4 -> wifi.f2 -> c14 -> wifiSend;
			f2: flow source imu.f1 -> c2 -> cpuSW.f12 -> c4 -> wifi.f2 -> c14 -> wifiSend;
		properties
			Actual_Processor_Binding => (reference (cpu)) applies to cpuSw;
			Actual_Processor_Binding => (reference (gpu)) applies to gpuSw;
			Actual_Memory_Binding => (reference (cpuMem), reference (storage)) applies to cpuSw;
			Actual_Memory_Binding => (reference (gpuMem)) applies to gpuSw;
			Actual_Connection_Binding => (reference (ser5)) applies to c2;
			Actual_Connection_Binding => (reference (ser3)) applies to c3, c4;
			Actual_Connection_Binding => (reference (ser6)) applies to c16, c17;
			Actual_Connection_Binding => (reference (ser2)) applies to c5, c6, cpuSw.ipcCom;
		-- NOTE: different threads in the CPU SW responsible for processing different types of data; 
		-- consider connecting SW or threads (representing drivers) to devices and bind the connections to the buses
	end Computer.Impl;
	
end HMD_Computer;
