MODULE main

VAR state_superstate : {nil};
VAR state_name : {nil,cybersickness-monitor};
VAR state_io_systemdata : {nil};
VAR state_operator_name : {initialize,nil,apply-latency-violated,apply-framerate-violated,apply-opticflow-violated};
VAR state_latency-upper-threshold : integer;
VAR state_latency-upper-threshold_exists : {yes,no};
VAR state_framerate-problem-threshold : integer;
VAR state_framerate-problem-threshold_exists : {yes,no};
VAR state_optic-flow-threshold : integer;
VAR state_optic-flow-threshold_exists : {yes,no};
VAR state_io_cybersickness-check : {none};
VAR state_io_cybersickness-level : {none,nil,affected-level-II,incapacitated-level-III,affected-level-I};
VAR state_io_systemdata_sys-latency : integer;
VAR state_io_systemdata_sys-latency_exists : {yes,no};
VAR state_io_systemdata_sys-framerate : integer;
VAR state_io_systemdata_sys-framerate_exists : {yes,no};
VAR state_io_systemdata_sys-opticflow : integer;
VAR state_io_systemdata_sys-opticflow_exists : {yes,no};


ASSIGN
    init (state_name) := nil;
    init (state_operator_name) := nil;
    init (state_latency-upper-threshold) := 0;
    init (state_latency-upper-threshold_exists) := no;
    init (state_framerate-problem-threshold) := 0;
    init (state_framerate-problem-threshold_exists) := no;
    init (state_optic-flow-threshold) := 0;
    init (state_optic-flow-threshold_exists) := no;
    init (state_io_cybersickness-level) := nil;
    init (state_io_systemdata_sys-latency) := 0;
    init (state_io_systemdata_sys-latency_exists) := yes;
    init (state_io_systemdata_sys-framerate) := 0;
    init (state_io_systemdata_sys-framerate_exists) := yes;
    init (state_io_systemdata_sys-opticflow) := 0;
    init (state_io_systemdata_sys-opticflow_exists) := yes;


VAR soarAgent : soarRules(state_superstate,state_name,state_io_systemdata,state_operator_name,state_latency-upper-threshold,state_latency-upper-threshold_exists,state_framerate-problem-threshold,state_framerate-problem-threshold_exists,state_optic-flow-threshold,state_optic-flow-threshold_exists,state_io_cybersickness-check,state_io_cybersickness-level,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists);
VAR inputModuleRule: inputModule(state_superstate,state_name,state_io_systemdata,state_operator_name,state_latency-mid-threshold,state_latency-mid-threshold_exists,state_latency-upper-threshold,state_latency-upper-threshold_exists,state_framerate-mid-threshold,state_framerate-mid-threshold_exists,state_framerate-problem-threshold,state_framerate-problem-threshold_exists,state_optic-flow-threshold,state_optic-flow-threshold_exists,state_io_cybersickness-check,state_io_cybersickness-level,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists);
LTLSPEC (G state_io_cybersickness-level != incapacitated-level-III)
--LTLSPEC (G (state_io_systemdata_sys-framerate >= 40) -> state_io_cybersickness-level != incapacitated-level-III)
MODULE inputModule(state_superstate,state_name,state_io_systemdata,state_operator_name,state_latency-mid-threshold,state_latency-mid-threshold_exists,state_latency-upper-threshold,state_latency-upper-threshold_exists,state_framerate-mid-threshold,state_framerate-mid-threshold_exists,state_framerate-problem-threshold,state_framerate-problem-threshold_exists,state_optic-flow-threshold,state_optic-flow-threshold_exists,state_io_cybersickness-check,state_io_cybersickness-level,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists)
ASSIGN
        next (state_io_systemdata_sys-opticflow) :=
            case
            (state_io_systemdata_sys-opticflow != 0) :0;
            TRUE: state_io_systemdata_sys-opticflow;
            esac;
        next (state_io_systemdata_sys-latency) :=
            case
            (state_io_systemdata_sys-latency = 0):60;
            TRUE: state_io_systemdata_sys-latency;
            esac;
--        next (state_io_systemdata_sys-framerate) :=
--            case
--            (state_io_systemdata_sys-framerate = 0):60;
--            TRUE: state_io_systemdata_sys-framerate;
--            esac;
        next (state_io_systemdata_sys-framerate) :=
            case
            (state_io_systemdata_sys-framerate = 0):40;
            (state_io_systemdata_sys-framerate = 40): state_io_systemdata_sys-framerate - 1;
            (state_io_systemdata_sys-framerate > 40 & state_io_systemdata_sys-framerate < 60): state_io_systemdata_sys-framerate + 1;
            (state_io_systemdata_sys-framerate = 60): 60;
            TRUE: state_io_systemdata_sys-framerate;
            esac;



MODULE soarRules(state_superstate,state_name,state_io_systemdata,state_operator_name,state_latency-upper-threshold,state_latency-upper-threshold_exists,state_framerate-problem-threshold,state_framerate-problem-threshold_exists,state_optic-flow-threshold,state_optic-flow-threshold_exists,state_io_cybersickness-check,state_io_cybersickness-level,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists)

VAR state:{start, run};
ASSIGN
        init (state) := start;
        next (state) :=
            case
        --propose*initialize (state_superstate,state_name,state_io_systemdata)
        state = start & (state_superstate = nil & state_name = nil) : run;
        --apply*initialize (state_operator_name)
        state = start & (state_operator_name = initialize) : run;
        --propose*latency-check (state_name,state_latency-upper-threshold,state_latency-upper-threshold_exists,state_io_systemdata,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists)
        state = start & (state_name = cybersickness-monitor & state_io_systemdata_sys-latency > state_latency-upper-threshold) : run;
        --propose*framerate-check (state_name,state_framerate-problem-threshold,state_framerate-problem-threshold_exists,state_io_systemdata,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists)
        state = start & (state_name = cybersickness-monitor & state_io_systemdata_sys-framerate < state_framerate-problem-threshold) : run;
        --propose*opticflow-check (state_name,state_optic-flow-threshold,state_optic-flow-threshold_exists,state_io_systemdata,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists)
        state = start & (state_name = cybersickness-monitor & state_io_systemdata_sys-opticflow < state_optic-flow-threshold) : run;
        --apply*apply-latency-violated (state_operator_name,state_io_cybersickness-level)
        state = start & (state_operator_name = apply-latency-violated) : run;
        --apply*apply-framerate-check (state_operator_name,state_io_cybersickness-level)
        state = start & (state_operator_name = apply-framerate-violated) : run;
        --apply*apply-opticflow-violated (state_operator_name,state_io_cybersickness-level)
        state = start & (state_operator_name = apply-opticflow-violated) : run;
        state = run : start;
            TRUE : state;
            esac;
TRANS
        next (state_operator_name) =
            case

        -- 10000.0        --propose*framerate-check (state_name,state_framerate-problem-threshold,state_framerate-problem-threshold_exists,state_io_systemdata,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists,state_io_systemdata_sys-framerate,state_io_systemdata_sys-framerate_exists)
        (state = run & state_name = cybersickness-monitor & state_io_systemdata_sys-framerate < state_framerate-problem-threshold): apply-framerate-violated;
        -- 10000.0        --propose*initialize (state_superstate,state_name,state_io_systemdata)
        (state = run & state_superstate = nil & state_name = nil): initialize;
        --propose*latency-check (state_name,state_latency-upper-threshold,state_latency-upper-threshold_exists,state_io_systemdata,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists,state_io_systemdata_sys-latency,state_io_systemdata_sys-latency_exists)
        (state = run & state_name = cybersickness-monitor & state_io_systemdata_sys-latency > state_latency-upper-threshold): apply-latency-violated;
        --propose*opticflow-check (state_name,state_optic-flow-threshold,state_optic-flow-threshold_exists,state_io_systemdata,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists,state_io_systemdata_sys-opticflow,state_io_systemdata_sys-opticflow_exists)
        (state = run & state_name = cybersickness-monitor & state_io_systemdata_sys-opticflow < state_optic-flow-threshold): apply-opticflow-violated;
            TRUE : state_operator_name;
            esac;
TRANS
        next (state_name) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): cybersickness-monitor;
            TRUE : state_name;
                esac;
TRANS
        next (state_latency-upper-threshold) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): 40;
            TRUE : state_latency-upper-threshold;
                esac;
TRANS
        next (state_latency-upper-threshold_exists) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): yes;
            TRUE : state_latency-upper-threshold_exists;
                esac;
TRANS
        next (state_framerate-problem-threshold) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): 40;
            TRUE : state_framerate-problem-threshold;
                esac;
TRANS
        next (state_framerate-problem-threshold_exists) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): yes;
            TRUE : state_framerate-problem-threshold_exists;
                esac;
TRANS
        next (state_optic-flow-threshold) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): 1;
            TRUE : state_optic-flow-threshold;
                esac;
TRANS
        next (state_optic-flow-threshold_exists) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): yes;
            TRUE : state_optic-flow-threshold_exists;
                esac;
TRANS
        next (state_io_cybersickness-check) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): none;
            TRUE : state_io_cybersickness-check;
                esac;
TRANS
        next (state_io_cybersickness-level) =
            case

        --apply*initialize (state_operator_name)
        (state = start & state_operator_name = initialize): none;
        --apply*apply-latency-violated (state_operator_name,state_io_cybersickness-level)
        (state = start & state_operator_name = apply-latency-violated): affected-level-II;
        --apply*apply-framerate-check (state_operator_name,state_io_cybersickness-level)
        (state = start & state_operator_name = apply-framerate-violated): incapacitated-level-III;
        --apply*apply-opticflow-violated (state_operator_name,state_io_cybersickness-level)
        (state = start & state_operator_name = apply-opticflow-violated): affected-level-I;
            TRUE : state_io_cybersickness-level;
                esac;

