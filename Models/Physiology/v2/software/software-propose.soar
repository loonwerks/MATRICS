# R0 If the duration of the mission surpasses 40 minutes, the cognition declines 

# sp {propose*duration-check
#     (state <s> ^name sw-cybersickness-monitor
#                ^duration-threshold  <dt>
#                ^io.input-link.systemdata <sd>)         
#     (<sd> ^sys-duration <sdt> > <dt>)
# -->
#     (write (crlf) |Checking for cybersickness for Duration of the Mission value: | <dt>)
#     (<s> ^operator <o> + >)
#     (<o> ^name apply-duration-violated)
# }


sp {propose*check*sw-cybersickness
    (state <s> ^name sw-cybersickness-monitor)
            #    ^sw-violated no)
-->
    (write (crlf) |Switched...|)
    (<s> ^operator <o> + >,=)
    (<o> ^name switch-monitor)
    }


























